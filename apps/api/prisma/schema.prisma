  VERIFIED
  REJECTED

  @@map("document_status")
}

// `loan_application_reviews` — review type and decision.
enum ApplicationReviewType {
  BRANCH_REVIEW
  /// Deliberately unwritten. A credit assessment is not a decision on the
  /// application's fate, and `ApplicationReviewDecision` has no value that
  /// honestly says "assessment recorded" — reusing APPROVED there would make
  /// the history panel claim the application was approved. Assessments live in
  /// `CreditAssessment` with their own read endpoint (Module 08).
  CREDIT_REVIEW
  FINAL_APPROVAL
  /// A reviewer adjusting rate or duration mid-review (Module 07 Scenario 16).
  /// Carried as a review row rather than a silent update so the pre-change terms
  /// stay recoverable — see `LoanApplicationReview.previous*`.
  MODIFY_TERMS
  /// Module 08: sanction issue, customer acceptance, customer decline and
  /// agreement signing. The reviewType is what distinguishes a customer's
  /// decline (SANCTION + REJECTED) from an admin's rejection
  /// (FINAL_APPROVAL + REJECTED) under Rule 13's unified REJECTED status.
  SANCTION

  @@map("application_review_type")
}

enum ApplicationReviewDecision {
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
  /// Not a decision on the application's fate — it records that the terms moved.
  /// The application stays UNDER_REVIEW and still needs an APPROVED/REJECTED row.
  TERMS_MODIFIED
  /// Module 08 lifecycle events after approval. A customer *decline* is not
  /// here: it is REJECTED with a SANCTION reviewType (Rule 13).
  SANCTIONED
  CUSTOMER_ACCEPTED
  AGREEMENT_SIGNED

  @@map("application_review_decision")
}

