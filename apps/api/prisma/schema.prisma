  penaltyRuleId          String?                @map("penalty_rule_id") @db.Uuid
  assessedDate           DateTime               @map("assessed_date") @db.Date
  /// The contractual assessed figure. Never rewritten by a payment — the same
  /// rule `Emi.totalDuePaise` follows (Rule 16, 17).
  amountPaise            BigInt                 @map("amount_paise")
  /// Maintained by collection allocation (Module 11), mirroring `Emi`. Without
  /// these, a partially-paid penalty could only be expressed as a status and
  /// every outstanding read would have to sum `CollectionAllocation`.
  paidAmountPaise        BigInt                 @default(0) @map("paid_amount_paise")
