/// A movement of cash custody from a field agent to their branch.
///
/// # Why this is not a payment
///
/// Receiving a handover posts `Dr 1210 Branch Cash / Cr 1220 Field Agent Cash`
/// and creates **no** customer repayment (Rules 21, 22). The customer already
/// paid when the agent took the money; this records that the money reached the
/// branch. A row here therefore carries no `loanId` and no `customerId` — it is
/// about two parties who both already have the cash on their books.
///
/// # Two idempotency keys, not one
///
/// Creating the handover and receiving it are two money-adjacent acts on one
/// row. `idempotencyKey` is minted by the agent's form and identifies the record
/// being created (a body field); `receiveIdempotencyKey` identifies a retry of
/// the *receive* against a row that already exists (an `Idempotency-Key`
/// header). That is the same split the codebase draws between Modules 09/11 and
/// Module 14, and collapsing it would make a retried receive indistinguishable
/// from a second handover.
///
/// # Concurrency
///
/// `updatedAt` is the optimistic-concurrency token, exposed to clients as
/// `version` and echoed back as `expectedVersion` — the same idiom as
/// `Collection` and `LoanApplication`. It is not the only guard: the real
/// protection against double-counting is the claim on
/// `Collection.custodyHandoverId`, because two receives racing on the same cash
/// contend on those rows rather than on this one.
model CashHandover {
  orgId      String @map("org_id") @db.Uuid
  handoverId String @default(uuid()) @map("handover_id") @db.Uuid

  /// `CH-<BRANCH CODE>-000001`, per branch. Minted inside the creating
  /// transaction by a numeric-max scan arbitrated by the unique index below —
  /// the same trade `ReceiptService` documents, where atomicity is chosen over
  /// guaranteed gaplessness.
  handoverNumber String @map("handover_number") @db.VarChar(50)

  /// Derived from the agent's own branch, never accepted from the client. That
  /// is what makes Scenarios 46 and 48 — receiving another branch's handover,
  /// and a client submitting foreign identifiers — structural.
  branchId     String @map("branch_id") @db.Uuid
  fieldAgentId String @map("field_agent_id") @db.Uuid

  /// DATE-only, Asia/Kolkata, from the server's clock. Client device time is
  /// not authoritative for financial posting (Rules 14, 15) and backdating is
  /// not permitted, so no endpoint accepts this.
  businessDate DateTime @map("business_date") @db.Date

  /// The agent's derived balance at the moment they submitted.
  ///
  /// A snapshot for the audit trail, not an input to any later decision: every
  /// check re-derives from posted collections inside its own transaction,
  /// because a figure cached between the check and the claim is a figure that
  /// can be stale exactly when it matters.
  expectedCashPaise   BigInt  @map("expected_cash_paise")
  handedOverCashPaise BigInt  @map("handed_over_cash_paise")
  /// What the branch physically counted. NULL until received — which is what
  /// lets the difference be real rather than assumed (Scenario 24).
  receivedCashPaise   BigInt? @map("received_cash_paise")

  /// `receivedCashPaise - handedOverCashPaise`, and **signed**.
  ///
  /// One of the two signed money columns in the schema (the other is the
  /// general-ledger balance). A difference is inherently directional; an
  /// unsigned amount plus a side discriminator would make every consumer branch
  /// before rendering. Pinned by the `cash_handovers_difference_identity`
  /// CHECK on any received row.
  differencePaise BigInt @default(0) @map("difference_paise")

  status                  CashHandoverStatus @map("handover_status")
  notes                   String?
  acknowledgmentReference String?            @map("acknowledgment_reference") @db.VarChar(150)

  receivedBy     String?   @map("received_by") @db.Uuid
  receivedAt     DateTime? @map("received_at") @db.Timestamptz(6)
  journalEntryId String?   @map("journal_entry_id") @db.Uuid

  idempotencyKey        String  @map("idempotency_key") @db.VarChar(150)
  /// SHA-256 hex of the canonical create request. Excludes `notes`, for the
  /// reason `Collection.requestFingerprint` documents.
  requestFingerprint    String? @map("request_fingerprint") @db.VarChar(64)
  receiveIdempotencyKey String? @map("receive_idempotency_key") @db.VarChar(150)

  reversalOfHandoverId String?   @map("reversal_of_handover_id") @db.Uuid
  reversalReason       String?   @map("reversal_reason")
  reversedAt           DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversedBy           String?   @map("reversed_by") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch         Branch        @relation(fields: [orgId, branchId], references: [orgId, branchId])
  fieldAgent     User          @relation("CashHandoverAgent", fields: [orgId, fieldAgentId], references: [orgId, userId])
  receivedByUser User?         @relation("CashHandoverReceiver", fields: [orgId, receivedBy], references: [orgId, userId])
  journalEntry   JournalEntry? @relation(fields: [orgId, journalEntryId], references: [orgId, journalEntryId])

  /// The original this row reverses, and the inverse.
  reversalOf         CashHandover? @relation("CashHandoverReversal", fields: [orgId, reversalOfHandoverId], references: [orgId, handoverId])
  reversedByHandover CashHandover? @relation("CashHandoverReversal")

  /// The collections whose cash this handover carries — the custody trail
  /// (Rule 23), as a real foreign key rather than a report.
  collections     Collection[]
  reconciliations CashReconciliation[]

  @@id([orgId, handoverId])
  @@unique([orgId, handoverNumber])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, receiveIdempotencyKey])
  /// What actually prevents a handover being reversed twice under concurrency.
  @@unique([orgId, reversalOfHandoverId])
  @@index([orgId, branchId, businessDate])
  @@index([orgId, fieldAgentId, businessDate])
  @@index([orgId, status])
  @@map("cash_handovers")
}

/// A count of received cash against what was expected, and what was decided
/// about any difference.
///
/// # This table posts nothing
///
/// Resolving a discrepancy records a type, a reason, an action and an approver.
/// It writes **no journal**. Rule 36 forbids an approval silently changing
/// historical amounts, and Scenario 29 says any accounting adjustment "follows
/// a separately authorized financial rule" — Module 14's manual journal is that
/// rule, and `approvalReference` carries its entry number. This is the same
/// posture `ReconciliationService` already takes for the ledger: it flags, it
/// never repairs.
///
/// The counted figures are frozen once written. The append-only trigger permits
/// only the transition to `RESOLVED` and pins `expectedCashPaise`,
/// `actualCashPaise` and `differencePaise`, which is Scenario 29's "the original
/// values remain historically traceable" enforced by the database rather than by
/// a service remembering to.
model CashReconciliation {
  orgId            String @map("org_id") @db.Uuid
  reconciliationId String @default(uuid()) @map("reconciliation_id") @db.Uuid

  /// `CR-<BRANCH CODE>-000001`, per branch. Same minting as the handover number.
  reconciliationNumber String @map("reconciliation_number") @db.VarChar(50)

  branchId     String @map("branch_id") @db.Uuid
  fieldAgentId String @map("field_agent_id") @db.Uuid

  /// Nullable so an agent-day reconciliation spanning several handovers remains
  /// expressible without a schema change. Every reconciliation written today
  /// names exactly one.
  handoverId String? @map("handover_id") @db.Uuid

  businessDate DateTime @map("business_date") @db.Date

  /// Copied from the handover's counted receipt, not supplied by the client:
  /// a client-supplied expectation would make the reconciliation circular.
  expectedCashPaise BigInt @map("expected_cash_paise")
  actualCashPaise   BigInt @map("actual_cash_paise")
  /// `actualCashPaise - expectedCashPaise`, signed. Negative is a shortage.
  /// Pinned unconditionally by the `cash_reconciliations_difference_identity`
  /// CHECK, so the three figures can never disagree.
  differencePaise   BigInt @map("difference_paise")

  status            CashReconciliationStatus   @map("reconciliation_status")
  discrepancyType   CashDiscrepancyType?       @map("discrepancy_type")
  discrepancyReason String?                    @map("discrepancy_reason")
  resolutionAction  CashDiscrepancyResolution? @map("resolution_action")
  resolutionNotes   String?                    @map("resolution_notes")

  /// A Module 14 journal entry number, when the resolution needed an
  /// accounting adjustment. Free text because it references another module's
  /// sequence rather than a row this one owns.
  approvalReference String? @map("approval_reference") @db.VarChar(150)

  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  approvedBy String?   @map("approved_by") @db.Uuid

  notes String?

  idempotencyKey     String  @map("idempotency_key") @db.VarChar(150)
  requestFingerprint String? @map("request_fingerprint") @db.VarChar(64)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch         Branch        @relation(fields: [orgId, branchId], references: [orgId, branchId])
  fieldAgent     User          @relation("CashReconciliationAgent", fields: [orgId, fieldAgentId], references: [orgId, userId])
  resolvedByUser User?         @relation("CashReconciliationResolver", fields: [orgId, resolvedBy], references: [orgId, userId])
  handover       CashHandover? @relation(fields: [orgId, handoverId], references: [orgId, handoverId])

  @@id([orgId, reconciliationId])
  @@unique([orgId, reconciliationNumber])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, branchId, businessDate])
  @@index([orgId, fieldAgentId, businessDate])
  @@index([orgId, status])
  @@index([orgId, handoverId])
  @@map("cash_reconciliations")
}

// ============================================================================
// 16. OVERDUE RECOVERY
// ============================================================================

/// Module 13. A borrower's delinquency, tracked as a case with an owner.
///
/// # Why there is no overdue snapshot table beside this one
///
/// Overdue status, days past due, the delinquency bucket and the four overdue
/// component totals are all **derived**, never stored. `deriveEmiStatus`
/// already computes `PENDING → DUE → OVERDUE` from the Asia/Kolkata business
/// date, and a stored copy would be a second reading of "which installment is
/// due" that drifts from the schedule screen within a release. Deriving them is
/// also what makes Scenario 8 replayable: the same schedule, payments and
/// business date always produce the same totals because nothing was cached.
///
/// A recovery case is different — it holds facts no calculation can produce: who
/// owns the case, what was promised, what was agreed, why it closed.
///
/// `updatedAt` is the optimistic-concurrency token, exposed to clients as
/// `version` exactly as `Collection.updatedAt` is (Scenarios 12, 52).
model RecoveryCase {
  orgId          String             @map("org_id") @db.Uuid
  recoveryCaseId String             @default(uuid()) @map("recovery_case_id") @db.Uuid
  /// `RC-<BRANCH>-000001`, allocated per branch inside the creating
  /// transaction, on the `RCP-`/`CH-`/`CR-` precedent.
  caseNumber     String?            @map("case_number") @db.VarChar(50)
  loanId         String             @map("loan_id") @db.Uuid
  emiId          String?            @map("emi_id") @db.Uuid
  branchId       String             @map("branch_id") @db.Uuid
  status         RecoveryCaseStatus
  priority       RecoveryPriority   @default(MEDIUM)
  /// Derived from days past due and then confirmed by an authorized action.
  /// Never written automatically — Rule 29.
  npaStatus      NpaStatus          @default(STANDARD) @map("npa_status")
  openedDate     DateTime           @map("opened_date") @db.Date
  closedDate     DateTime?          @map("closed_date") @db.Date

  /// The current assignee, and when they took the case.
  ///
  /// A denormalised pointer at the newest `RecoveryCaseAssignment`, kept so the
  /// worklist query stays a single read. The history is the authority; Rule 25
  /// is satisfied by that table, not by this column.
  assignedAgentId String?   @map("assigned_agent_id") @db.Uuid
  assignmentDate  DateTime? @map("assignment_date") @db.Date

  createdBy      String?                 @map("created_by") @db.Uuid
  closedBy       String?                 @map("closed_by") @db.Uuid
  closureReason  String?                 @map("closure_reason")
  resolutionType RecoveryResolutionType? @map("resolution_type")

  /// The closure snapshot. Frozen at closure rather than derived, so the record
  /// stays true after later movements on the loan (Scenario 39). The
  /// `recovery_cases_closure_sums` CHECK holds them consistent.
  outstandingBeforePaise    BigInt? @map("outstanding_before_paise")
  recoveredAmountPaise      BigInt? @map("recovered_amount_paise")
  remainingOutstandingPaise BigInt? @map("remaining_outstanding_paise")

  approvalReference String?   @map("approval_reference") @db.VarChar(150)
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz(6)
  escalationReason  String?   @map("escalation_reason")

  idempotencyKey     String?  @map("idempotency_key") @db.VarChar(150)
  /// SHA-256 hex of the canonical request body, on `Collection`'s precedent.
  requestFingerprint String?  @map("request_fingerprint") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan          Loan         @relation(fields: [orgId, loanId], references: [orgId, loanId], onDelete: Cascade)
  emi           Emi?         @relation(fields: [orgId, emiId], references: [orgId, emiId])
  branch        Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])
  assignedAgent User?        @relation("RecoveryCaseAssignee", fields: [orgId, assignedAgentId], references: [orgId, userId])
  createdByUser User?        @relation("RecoveryCaseCreatedBy", fields: [orgId, createdBy], references: [orgId, userId])
  closedByUser  User?        @relation("RecoveryCaseClosedBy", fields: [orgId, closedBy], references: [orgId, userId])

  actions      RecoveryAction[]
  assignments  RecoveryCaseAssignment[]
  legalNotices LegalNotice[]
  settlements  Settlement[]

  @@id([orgId, recoveryCaseId])
  @@unique([orgId, caseNumber])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, status])
  @@index([orgId, branchId, status])
  @@index([orgId, loanId])
  @@index([orgId, assignedAgentId, status])
  @@map("recovery_cases")
}

/// Module 13. Who held a recovery case, and when.
///
/// # Why this table exists rather than a mutable column
///
/// Rule 25 requires reassignment to preserve historical assignment
/// information; Scenario 10 requires the previous assignment to remain visible
/// afterwards; Scenario 54 requires the audit history to record both the
/// previous and the new assignee. Overwriting `RecoveryCase.assignedAgentId`
/// destroys exactly the fact all three require be kept.
///
/// The audit log is not a substitute. It is a security record — sanitized,
/// queried by actor, and deliberately not joined to domain reads — not a
/// history the case screen can render in order.
///
/// Append-only, enforced by the `recovery_case_assignments_append_only`
/// trigger. `fromUserId` is NULL on the first assignment, which distinguishes
/// an assignment from a reassignment without a second column saying so.
model RecoveryCaseAssignment {
  orgId          String   @map("org_id") @db.Uuid
  assignmentId   String   @default(uuid()) @map("assignment_id") @db.Uuid
  recoveryCaseId String   @map("recovery_case_id") @db.Uuid
  fromUserId     String?  @map("from_user_id") @db.Uuid
  toUserId       String   @map("to_user_id") @db.Uuid
  assignedBy     String   @map("assigned_by") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  reason         String?

  organization   Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  recoveryCase   RecoveryCase @relation(fields: [orgId, recoveryCaseId], references: [orgId, recoveryCaseId], onDelete: Cascade)
  fromUser       User?        @relation("RecoveryAssignmentFrom", fields: [orgId, fromUserId], references: [orgId, userId])
  toUser         User         @relation("RecoveryAssignmentTo", fields: [orgId, toUserId], references: [orgId, userId])
  assignedByUser User         @relation("RecoveryAssignmentBy", fields: [orgId, assignedBy], references: [orgId, userId])

  @@id([orgId, assignmentId])
  @@index([orgId, recoveryCaseId, assignedAt])
  @@index([orgId, toUserId])
  @@map("recovery_case_assignments")
}

/// Module 13. One recorded recovery activity: a call, a visit, a notice.
///
/// A recovery action never moves money (Rule 15). A promise to pay is stored
/// here and does **not** reduce any balance (Scenario 15); the payment it
/// promises, if it arrives, is posted through Module 11's collection workflow
/// like every other repayment.
///
/// `finalizedAt` is the freeze. NULL means pending and editable (Scenario 31);
/// non-NULL means the outcome is history and a correction must be a follow-up
/// action (Scenarios 32, 35). Enforced by the `recovery_actions_append_only`
/// trigger, not only by the service.
model RecoveryAction {
  orgId            String             @map("org_id") @db.Uuid
  recoveryActionId String             @default(uuid()) @map("recovery_action_id") @db.Uuid
  recoveryCaseId   String             @map("recovery_case_id") @db.Uuid
  action           RecoveryActionType
  /// DATE, not a timestamp: an action happened on a business day, and a
  /// timestamp would let a device's clock decide which day a visit fell on
  /// (Rules 5, 14).
  actionDate       DateTime?          @map("action_date") @db.Date
  outcome          RecoveryOutcome?
  performedBy      String             @map("performed_by") @db.Uuid
  notes            String?

  nextFollowUpDate        DateTime? @map("next_follow_up_date") @db.Date
  /// A promise is an amount AND a date, or neither — half a promise cannot be
  /// followed up or checked against a payment. Held by the
  /// `recovery_actions_promise_paired` CHECK.
  promiseToPayDate        DateTime? @map("promise_to_pay_date") @db.Date
  promiseToPayAmountPaise BigInt?   @map("promise_to_pay_amount_paise")

  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)

  /// Module 12's offline identity, reused verbatim. The device mints the UUID
  /// and the unique index makes a retried sync return the original row rather
  /// than create a second (Scenario 28).
  offlineActivityUuid  String?                @map("offline_activity_uuid") @db.Uuid
  deviceId             String?                @map("device_id") @db.VarChar(150)
  /// What the device reported about its GPS attempt. Stored separately from
  /// `gpsCheckInId` because a **failed** capture has no check-in row to point
  /// at and Rule 40 requires the failure still be representable. Written from
  /// what the client reported and never promoted: synchronization must not turn
  /// a failure into a success (Scenario 30).
  gpsCaptureStatus     GpsVerificationStatus? @map("gps_capture_status")
  gpsCheckInId         String?                @map("gps_check_in_id") @db.Uuid
  customerAckReference String?                @map("customer_ack_reference") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  recoveryCase    RecoveryCase @relation(fields: [orgId, recoveryCaseId], references: [orgId, recoveryCaseId], onDelete: Cascade)
  performedByUser User         @relation("RecoveryActionPerformedBy", fields: [orgId, performedBy], references: [orgId, userId])
  gpsCheckIn      GpsCheckIn?  @relation(fields: [orgId, gpsCheckInId], references: [orgId, checkInId])

  @@id([orgId, recoveryActionId])
  @@unique([orgId, offlineActivityUuid])
  @@index([orgId, recoveryCaseId])
  @@index([orgId, nextFollowUpDate])
  /// The missed-promise sweep of Scenario 16.
  @@index([orgId, promiseToPayDate])
  @@map("recovery_actions")
}

model LegalNotice {
  orgId            String            @map("org_id") @db.Uuid
  legalNoticeId    String            @default(uuid()) @map("legal_notice_id") @db.Uuid
  recoveryCaseId   String            @map("recovery_case_id") @db.Uuid
  noticeDate       DateTime          @map("notice_date") @db.Date
  noticePeriodDays Int               @default(30) @map("notice_period_days")
  expiryDate       DateTime          @map("expiry_date") @db.Date
  status           LegalNoticeStatus
  documentRef      String?           @map("document_ref")
  noticeReference  String?           @map("notice_reference") @db.VarChar(150)
  issuedBy         String?           @map("issued_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  recoveryCase RecoveryCase @relation(fields: [orgId, recoveryCaseId], references: [orgId, recoveryCaseId], onDelete: Cascade)
  issuedByUser User?        @relation("LegalNoticeIssuedBy", fields: [orgId, issuedBy], references: [orgId, userId])

  @@id([orgId, legalNoticeId])
  @@index([orgId, recoveryCaseId])
  @@map("legal_notices")
}

/// Module 13. An agreed reduction of what the borrower must pay.
///
/// A settlement is one of only two genuinely ledger-affecting acts this module
/// owns (the other is a write-off). Completing one posts
/// `Dr 5100 Loan Write-off Expense / Cr 1100 Loan Receivable` for the waived
/// portion: the asset raised at disbursal is retired because it will not be
/// collected. The settled portion itself is an ordinary repayment and goes
/// through Module 11's collection workflow (Rules 15, 16).
///
/// A COMPLETED settlement is frozen by the `settlements_append_only` trigger —
/// corrections are reversals in the ledger, never edits here (Rule 31).
model Settlement {
  orgId                  String           @map("org_id") @db.Uuid
  settlementId           String           @default(uuid()) @map("settlement_id") @db.Uuid
  recoveryCaseId         String           @map("recovery_case_id") @db.Uuid
  loanId                 String           @map("loan_id") @db.Uuid
  settlementAmountPaise  BigInt           @map("settlement_amount_paise")
  /// What was owed when the settlement was agreed, and what was forgiven. Held
  /// consistent with `settlementAmountPaise` by the `settlements_waiver_sums`
  /// CHECK.
  outstandingBeforePaise BigInt?          @map("outstanding_before_paise")
  waivedAmountPaise      BigInt?          @map("waived_amount_paise")
  status                 SettlementStatus
  agreedDate             DateTime?        @map("agreed_date") @db.Date
  completedDate          DateTime?        @map("completed_date") @db.Date
  approvedBy             String?          @map("approved_by") @db.Uuid
  approvedAt             DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvalReference      String?          @map("approval_reference") @db.VarChar(150)
  reason                 String?
  journalEntryId         String?          @map("journal_entry_id") @db.Uuid
  createdBy              String?          @map("created_by") @db.Uuid
  idempotencyKey         String?          @map("idempotency_key") @db.VarChar(150)
  requestFingerprint     String?          @map("request_fingerprint") @db.VarChar(64)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  recoveryCase   RecoveryCase  @relation(fields: [orgId, recoveryCaseId], references: [orgId, recoveryCaseId], onDelete: Cascade)
  loan           Loan          @relation(fields: [orgId, loanId], references: [orgId, loanId])
  journalEntry   JournalEntry? @relation(fields: [orgId, journalEntryId], references: [orgId, journalEntryId])
  approvedByUser User?         @relation("SettlementApprovedBy", fields: [orgId, approvedBy], references: [orgId, userId])
  createdByUser  User?         @relation("SettlementCreatedBy", fields: [orgId, createdBy], references: [orgId, userId])

  @@id([orgId, settlementId])
  @@unique([orgId, idempotencyKey])
  @@index([orgId, recoveryCaseId])
  @@index([orgId, loanId])
  @@map("settlements")
}

// ============================================================================
// 17. LOAN CLOSURE / NOC / RECEIPTS
// ============================================================================

model LoanClosure {
  orgId              String                    @map("org_id") @db.Uuid
  loanClosureId      String                    @default(uuid()) @map("loan_closure_id") @db.Uuid
  loanId             String                    @map("loan_id") @db.Uuid
  closureDate        DateTime                  @map("closure_date") @db.Date
  closureAmountPaise BigInt                    @map("closure_amount_paise")
  verificationStatus ClosureVerificationStatus @map("verification_status")
  finalCollectionId  String?                   @map("final_collection_id") @db.Uuid
  closedBy           String                    @map("closed_by") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan            Loan         @relation(fields: [orgId, loanId], references: [orgId, loanId], onDelete: Cascade)
  finalCollection Collection?  @relation(fields: [orgId, finalCollectionId], references: [orgId, collectionId])

  receipts Receipt[]

  @@id([orgId, loanClosureId])
  @@index([orgId, loanId])
  @@map("loan_closures")
}

model Noc {
  orgId      String    @map("org_id") @db.Uuid
  nocId      String    @default(uuid()) @map("noc_id") @db.Uuid
  loanId     String    @map("loan_id") @db.Uuid
  nocNumber  String    @map("noc_number") @db.VarChar(100)
  issuedDate DateTime  @map("issued_date") @db.Date
  fileRef    String?   @map("file_ref")
  status     NocStatus
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan         Loan         @relation(fields: [orgId, loanId], references: [orgId, loanId], onDelete: Cascade)

  @@id([orgId, nocId])
  @@unique([orgId, nocNumber])
  @@index([orgId, loanId])
  @@map("nocs")
}

model Receipt {
  orgId         String      @map("org_id") @db.Uuid
  receiptId     String      @default(uuid()) @map("receipt_id") @db.Uuid
  receiptNumber String      @map("receipt_number") @db.VarChar(100)
  loanId        String      @map("loan_id") @db.Uuid
  collectionId  String?     @map("collection_id") @db.Uuid
  loanClosureId String?     @map("loan_closure_id") @db.Uuid
  receiptType   ReceiptType @map("receipt_type")
  amountPaise   BigInt      @map("amount_paise")
  fileRef       String?     @map("file_ref")
  generatedAt   DateTime    @map("generated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan         Loan         @relation(fields: [orgId, loanId], references: [orgId, loanId])
  collection   Collection?  @relation(fields: [orgId, collectionId], references: [orgId, collectionId])
  loanClosure  LoanClosure? @relation(fields: [orgId, loanClosureId], references: [orgId, loanClosureId])

  @@id([orgId, receiptId])
  @@unique([orgId, receiptNumber])
  @@index([orgId, loanId])
  @@map("receipts")
}

// ============================================================================
// 19-20. CHART OF ACCOUNTS / DIMENSIONS
// ============================================================================

model Account {
  orgId           String        @map("org_id") @db.Uuid
  accountId       String        @default(uuid()) @map("account_id") @db.Uuid
  accountCode     String        @map("account_code") @db.VarChar(50)
  accountName     String        @map("account_name") @db.VarChar(200)
  accountType     AccountType   @map("account_type")
  normalBalance   NormalBalance @map("normal_balance")
  parentAccountId String?       @map("parent_account_id") @db.Uuid
  status          AccountStatus
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- Module 14 (Accounting & Ledger) ---

  accountCategory String? @map("account_category") @db.VarChar(100)
  description     String?

  /// Whether a journal line may reference this account at all.
  ///
  /// Defaults true so the six accounts Modules 09/11 already post to keep
  /// working with no backfill. A control/parent account sets it false.
  isPostable Boolean @default(true) @map("is_postable")

  /// Whether a *hand-authored* journal may reference this account.
  ///
  /// Deliberately defaults false, unlike `isPostable`. A manual journal may
  /// only touch accounts explicitly opened to it; a source module posting
  /// through LedgerService is not subject to this flag. The migration opens
  /// bank, cash and the three income accounts, and pointedly leaves 1100 Loan
  /// Receivable closed — see `isControlAccount`.
  isManualPostingAllowed Boolean @default(false) @map("is_manual_posting_allowed")

  /// A control account whose balance is driven by a subsidiary ledger.
  ///
  /// 1100 Loan Receivable is the case that matters: the loan book drives it,
  /// and hand-posting to it would desynchronise the two.
  isControlAccount Boolean @default(false) @map("is_control_account")

  branchScope AccountBranchScope @default(ORGANIZATION) @map("branch_scope")

  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  /// The optimistic-concurrency token, as an ISO string over the wire.
  ///
  /// Not an Int `version` column: the codebase's established convention is
  /// `updatedAt` (see `collection.service.ts` assertVersion), and a second
  /// mechanism for accounting alone would be one more thing to get wrong.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  parentAccount Account?     @relation("AccountHierarchy", fields: [orgId, parentAccountId], references: [orgId, accountId])

  childAccounts Account[]          @relation("AccountHierarchy")
  dimensions    AccountDimension[]
  journalLines  JournalLine[]
  disbursements Disbursement[]     @relation("DisbursementFundingAccount")

  @@id([orgId, accountId])
  @@unique([orgId, accountCode])
  @@index([orgId, status])
  @@index([orgId, accountType])
  @@index([orgId, parentAccountId])
  @@map("accounts")
}

model AccountDimension {
  orgId       String   @map("org_id") @db.Uuid
  dimensionId String   @default(uuid()) @map("dimension_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  loanId      String?  @map("loan_id") @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  account      Account      @relation(fields: [orgId, accountId], references: [orgId, accountId])

  journalLines JournalLine[]

  @@id([orgId, dimensionId])
  @@index([orgId, loanId])
  @@index([orgId, customerId])
  @@index([orgId, branchId])
  @@index([orgId, accountId])
  @@map("account_dimensions")
}

// ============================================================================
// 21. DOUBLE-ENTRY LEDGER
//
// Append-only. Corrections are reversal entries, never mutations.
// The sum-to-zero invariant is enforced by a deferred constraint trigger
// installed via raw SQL migration (Prisma cannot express it).
// ============================================================================

model JournalEntry {
  orgId          String             @map("org_id") @db.Uuid
  journalEntryId String             @default(uuid()) @map("journal_entry_id") @db.Uuid
  entryNumber    String             @map("entry_number") @db.VarChar(100)
  entryDate      DateTime           @map("entry_date") @db.Date
  /// Null while the entry is a DRAFT.
  ///
  /// Module 14 introduces the draft state, and a draft has not been posted —
  /// a NOT NULL column here would force every draft to carry a posting
  /// timestamp that is a lie. The DRAFT -> POSTED trigger refuses the
  /// transition unless this and `postedBy` are both set.
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(6)
  entryType      JournalEntryType   @map("entry_type")
  status         JournalEntryStatus
  sourceType     String?            @map("source_type") @db.VarChar(50)
  sourceId       String?            @map("source_id") @db.Uuid
  description    String?
  createdBy      String             @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // --- Module 14 (Accounting & Ledger) ---

  /// The branch this posting belongs to.
  ///
  /// Backfilled from the `AccountDimension` rows the entry's lines already
  /// carry. Reads filter on this rather than joining through dimensions, which
  /// is what makes branch confinement a `where` clause.
  branchId String? @map("branch_id") @db.Uuid

  /// Set on a reversal entry, pointing at the entry it reverses.
  ///
  /// A partial unique index on (org_id, original_journal_entry_id) is what
  /// actually prevents a journal being reversed twice under concurrency.
  originalJournalEntryId String? @map("original_journal_entry_id") @db.Uuid

  reversalReason    String? @map("reversal_reason")
  adjustmentReason  String? @map("adjustment_reason")
  approvalReference String? @map("approval_reference") @db.VarChar(150)

  idempotencyKey     String? @map("idempotency_key") @db.VarChar(150)
  /// SHA-256 hex of the canonical request. Named `requestFingerprint`, never
  /// `requestHash`: `sanitizeMetadata` drops any audit metadata key matching
  /// /hash/i and the trail would be silently empty.
  requestFingerprint String? @map("request_fingerprint") @db.VarChar(64)

  postedBy String? @map("posted_by") @db.Uuid

  /// Optimistic-concurrency token for draft edits. See `Account.updatedAt`.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch        Branch?       @relation(fields: [orgId, branchId], references: [orgId, branchId])
  originalEntry JournalEntry? @relation("JournalReversal", fields: [orgId, originalJournalEntryId], references: [orgId, journalEntryId])

  reversalEntries JournalEntry[] @relation("JournalReversal")
  lines           JournalLine[]
  disbursements   Disbursement[]
  collections     Collection[]
  cashHandovers   CashHandover[]
  settlements     Settlement[]

  @@id([orgId, journalEntryId])
  @@unique([orgId, entryNumber])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, originalJournalEntryId])
  @@index([orgId, entryDate])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, status, entryDate])
  @@index([orgId, branchId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  orgId          String   @map("org_id") @db.Uuid
  journalLineId  String   @default(uuid()) @map("journal_line_id") @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  lineNumber     Int      @map("line_number")
  accountId      String   @map("account_id") @db.Uuid
  dimensionId    String?  @map("dimension_id") @db.Uuid
  debitPaise     BigInt   @default(0) @map("debit_paise")
  creditPaise    BigInt   @default(0) @map("credit_paise")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Which part of the source transaction this line represents:
  /// PENALTY | INTEREST | PRINCIPAL | FEE | FUNDING | MANUAL.
  ///
  /// Purely additive. It is what lets reconciliation trace a source
  /// transaction to its journal at line granularity rather than entry
  /// granularity.
  sourceComponent String? @map("source_component") @db.VarChar(50)

  organization Organization      @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  journalEntry JournalEntry      @relation(fields: [orgId, journalEntryId], references: [orgId, journalEntryId], onDelete: Cascade)
  account      Account           @relation(fields: [orgId, accountId], references: [orgId, accountId])
  dimension    AccountDimension? @relation(fields: [orgId, dimensionId], references: [orgId, dimensionId])

  @@id([orgId, journalLineId])
  @@unique([orgId, journalEntryId, lineNumber])
  @@index([orgId, journalEntryId])
  @@index([orgId, accountId])
  @@map("journal_lines")
}

// ============================================================================
// 25. EXPENSES / CASH MANAGEMENT
// ============================================================================

model ExpenseCategory {
  orgId             String       @map("org_id") @db.Uuid
  expenseCategoryId String       @default(uuid()) @map("expense_category_id") @db.Uuid
  code              String       @db.VarChar(50)
  name              String       @db.VarChar(150)
  status            RecordStatus
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  expenses Expense[]

  @@id([orgId, expenseCategoryId])
  @@unique([orgId, code])
  @@map("expense_categories")
}

model Expense {
  orgId       String        @map("org_id") @db.Uuid
  expenseId   String        @default(uuid()) @map("expense_id") @db.Uuid
  branchId    String        @map("branch_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  amountPaise BigInt        @map("amount_paise")
  expenseDate DateTime      @map("expense_date") @db.Date
  paymentMode PaymentMode   @map("payment_mode")
  description String?
  status      ExpenseStatus
  createdBy   String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch          @relation(fields: [orgId, branchId], references: [orgId, branchId])
  category     ExpenseCategory @relation(fields: [orgId, categoryId], references: [orgId, expenseCategoryId])

  @@id([orgId, expenseId])
  @@index([orgId, branchId, expenseDate])
  @@map("expenses")
}

model DayClosing {
  orgId        String           @map("org_id") @db.Uuid
  dayClosingId String           @default(uuid()) @map("day_closing_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  closingDate  DateTime         @map("closing_date") @db.Date
  status       DayClosingStatus
  closedBy     String?          @map("closed_by") @db.Uuid
  closedAt     DateTime?        @map("closed_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])

  @@id([orgId, dayClosingId])
  @@unique([orgId, branchId, closingDate])
  @@map("day_closings")
}

model CashBookEntry {
  orgId           String            @map("org_id") @db.Uuid
  cashBookEntryId String            @default(uuid()) @map("cash_book_entry_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  entryDate       DateTime          @map("entry_date") @db.Date
  entryType       CashBookEntryType @map("entry_type")
  amountPaise     BigInt            @map("amount_paise")
  sourceType      String?           @map("source_type") @db.VarChar(50)
  sourceId        String?           @map("source_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])

  @@id([orgId, cashBookEntryId])
  @@index([orgId, branchId, entryDate])
  @@map("cash_book_entries")
}

// ============================================================================
// 26. AUDIT LOGS
//
// Append-only. Application DB roles get INSERT/SELECT but no UPDATE/DELETE
// (enforced by raw SQL migration).
// ============================================================================

model AuditLog {
  orgId       String   @map("org_id") @db.Uuid
  auditId     String   @default(uuid()) @map("audit_id") @db.Uuid
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(150)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  requestId   String?  @map("request_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  metadata    Json?

  /// Module 17. The branch the audited event *belongs to*, which is not always
  /// the branch of the actor — a head-office user acting on a branch record
  /// produces a row scoped to that branch.
  ///
  /// Retrofitted, and therefore NULL for every row written before Module 17 and
  /// for every call site that does not yet pass it. `AuditQueryService` must
  /// consequently confine a branch-scoped reader with
  /// `branchId = theirs OR (branchId IS NULL AND actor is in their branch)`.
  /// Collapsing that to `branchId: actor.branchId` silently hides every legacy
  /// event — and an empty list looks like a working filter, not a bug.
  branchId String? @map("branch_id") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  actorUser    User?        @relation(fields: [orgId, actorUserId], references: [orgId, userId])

  @@id([orgId, auditId])
  @@index([orgId, occurredAt])
  @@index([orgId, entityType, entityId])
  @@index([orgId, actorUserId])
  /// The branch-confined audit list (Scenario 36).
  @@index([orgId, branchId, occurredAt])
  /// The `action` and `result` filters of Scenario 38.
  @@index([orgId, action, occurredAt])
  @@map("audit_logs")
}

// ============================================================================
// 27. NOTIFICATIONS
// ============================================================================

/// Which SMS gateway an organization uses, and how to address it.
///
/// Credentials are deliberately absent. The Twilio auth token lives in the
/// environment, never here, so a database dump or a support query with table
/// access can never yield a credential that sends SMS at the organization's
/// cost. This is the same rule that keeps AUTH_JWT_SECRET out of the schema and
/// stores refresh tokens, reset tokens and OTPs only as hashes.
///
/// The split: the database says *which* provider and *how to address it*; the
/// environment says *how to authenticate*.
///
/// A missing or disabled row falls back to the SMS_PROVIDER environment value,
/// so an organization that has never been configured behaves exactly as before.
model SmsProviderConfig {
  orgId    String          @map("org_id") @db.Uuid
  configId String          @default(uuid()) @map("config_id") @db.Uuid
  provider SmsProviderKind

  /// Twilio Messaging Service SID. Preferred over fromNumber when both are set,
  /// because it handles sender-ID selection and failover on Twilio's side.
  messagingServiceSid String? @map("messaging_service_sid") @db.VarChar(64)
  fromNumber          String? @map("from_number") @db.VarChar(20)

  /// E.164 prefix applied to the 10-digit numbers stored on users. Defaults to
  /// India, matching the +91-specific /^[6-9]\d{9}$/ rule in @lms/validation.
  defaultCountryCode String @default("+91") @map("default_country_code") @db.VarChar(5)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@id([orgId, configId])
  /// One configuration per organization, so resolution is a single indexed
  /// lookup with no ordering ambiguity.
  @@unique([orgId])
  @@map("sms_provider_configs")
}

/// Which outbound email gateway an organization uses, and how to address mail
/// sent through it.
///
/// Deliberately mirrors `SmsProviderConfig`, including its central omission:
/// there is no password column. The database says *which* provider and *how to
/// address it*; the environment (`SMTP_PASSWORD`) says how to authenticate. A
/// missing or disabled row falls back to the `EMAIL_PROVIDER` environment
/// value, so an organization that has never been configured logs to the console
/// rather than failing.
model EmailProviderConfig {
  orgId    String            @map("org_id") @db.Uuid
  configId String            @default(uuid()) @map("config_id") @db.Uuid
  provider EmailProviderKind

  host   String? @db.VarChar(200)
  port   Int?
  /// Implicit TLS (port 465). False means STARTTLS is negotiated on a plain
  /// connection, which is what port 587 expects.
  secure Boolean @default(true)

  username String? @db.VarChar(200)

  /// Envelope sender. Sized to RFC 5321's 320-character maximum, matching
  /// `User.email`.
  fromAddress String? @map("from_address") @db.VarChar(320)
  fromName    String? @map("from_name") @db.VarChar(200)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@id([orgId, configId])
  /// One configuration per organization, so resolution is a single indexed
  /// lookup with no ordering ambiguity.
  @@unique([orgId])
  @@map("email_provider_configs")
}

/// One authoritative business event, recorded for notification processing.
///
/// This is Module 16's outbox. The specification names a separate
/// `outbox_event` table, but an outbox exists to make publication atomic with
/// the business write, and Module 16 deliberately emits *after* the source
/// transaction commits (Rules 60-62) — so a second table would buy a second
/// deduplication index to keep in step and nothing else.
///
/// The fan-out is three levels, which is the shape the specification's own
/// field list describes: one event produces N `Notification` rows, one per
/// resolved recipient (Rule 11), each producing M `NotificationDelivery`
/// attempts (Rule 15).
///
/// Accepted trade-off: a source transaction that commits and then dies before
/// this row is written loses that notification. Rule 62 explicitly permits a
/// notification to be delayed or lost without rolling back committed business
/// data, and the daily reminder sweeps re-raise the financially important
/// cases.
// TODO(open-question): Q-NOTIF-34 — whether generation should instead happen
// inside the source transaction. Doing so would trade this gap for the far
// worse property of a provider outage rolling back money movement.
model NotificationSourceEvent {
  orgId   String @map("org_id") @db.Uuid
  eventId String @default(uuid()) @map("event_id") @db.Uuid

  /// The branch the source event belongs to; null for organization-wide events
  /// (Rule 2). Recipient resolution and every administrative read filter on it.
  branchId String? @map("branch_id") @db.Uuid

  eventType NotificationEvent @map("event_type")

  /// The owning module and record, so a notification can cite its authoritative
  /// source (Rule 8) and the list can be filtered by source module (Rule 54).
  sourceModule   String  @map("source_module") @db.VarChar(50)
  sourceRecordId String? @map("source_record_id") @db.Uuid

  /// What distinguishes a legitimate repeat of an event from a replay of the
  /// same one. For a state change it is the source row's version or updated-at;
  /// for a scheduled reminder it is the Asia/Kolkata business date, which is
  /// what makes a same-day re-run of the sweep produce nothing while the next
  /// day's run produces the next reminder.
  sourceVersion String? @map("source_version") @db.VarChar(64)

  /// `{EVENT_TYPE}:{sourceModule}:{sourceRecordId}:{sourceVersion}` unless the
  /// caller supplied a better natural identity. The unique index below is the
  /// actual guarantee (Rules 12, 14, 22, 23); the service's pre-check only makes
  /// a duplicate readable in the audit trail rather than a raw constraint error.
  deduplicationKey String @map("deduplication_key") @db.VarChar(300)

  /// The already-computed authoritative values the template renders.
  ///
  /// Money is carried as a decimal *string* of paise and never as a JSON
  /// number, because JSON numbers are IEEE-754 doubles and Rule 25 prohibits
  /// floating-point money anywhere in notification generation. Business dates
  /// are `YYYY-MM-DD` strings for the same reason in reverse: a timestamp would
  /// invent a time component that Rules 26 and 68 forbid.
  payload Json

  /// When the business event actually happened, which is not when this row was
  /// written and not when any delivery was attempted (Rule 67).
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  status        NotificationEventStatus @default(PENDING)
  processedAt   DateTime?               @map("processed_at") @db.Timestamptz(6)
  /// Why generation failed (Scenarios 52, 53). Never implies anything about the
  /// source transaction, which committed before this row existed.
  failureReason String?                 @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch        Branch?        @relation(fields: [orgId, branchId], references: [orgId, branchId])
  notifications Notification[]

  @@id([orgId, eventId])
  /// Rules 12, 14, 22, 23 and Scenario 23: the same source event received twice
  /// cannot produce two sets of notifications.
  @@unique([orgId, deduplicationKey])
  /// The ingestion worker's claim query.
  @@index([orgId, status, createdAt])
  @@index([orgId, eventType, occurredAt])
  @@map("notification_events")
}

/// A message template, versioned so that editing it cannot rewrite history.
///
/// Templates are never interpreted as code: rendering is `{{token}}`
/// substitution against a flat map of already-computed strings, with no
/// expressions, arithmetic or conditionals. That is Rules 25 and 27 made
/// structural — a template that *cannot* compute cannot recompute an EMI,
/// re-derive an overdue amount, or introduce a float.
model NotificationTemplate {
  orgId         String                     @map("org_id") @db.Uuid
  templateId    String                     @default(uuid()) @map("template_id") @db.Uuid
  code          String                     @db.VarChar(100)
  /// Human-readable identity, unique per organization (Rule 35).
  name          String                     @db.VarChar(150)
  category      String                     @db.VarChar(50)
  eventType     NotificationEvent          @map("event_type")
  /// The module the event originates from, so the Templates screen can group by
  /// it and rule validation can check the pairing (Scenario 15).
  sourceModule  String                     @map("source_module") @db.VarChar(50)
  channel       NotificationChannel
  subject       String?                    @db.VarChar(250)
  /// Rendered into `Notification.title`. Separate from `subject`, which is the
  /// email header line and has no meaning for IN_APP.
  titleTemplate String?                    @map("title_template") @db.VarChar(500)
  body          String
  status        NotificationTemplateStatus

  locale String @default("en") @db.VarChar(10)

  /// Whether rendered output may contain personally identifying or financial
  /// detail. The renderer refuses to put a PII template on SMS or EMAIL, which
  /// is how Rules 55 and 56 are enforced at generation rather than by reviewing
  /// each seeded template by eye.
  containsPii Boolean @default(false) @map("contains_pii")
  sensitivity String  @default("INTERNAL") @db.VarChar(20)

  /// Incremented on every content edit. `Notification.templateVersion` records
  /// which version produced its frozen content, so Scenario 8 holds without the
  /// module storing a full template history (Rule 39).
  version Int @default(1)

  /// Protected system templates, which an organization administrator may edit
  /// but never delete (Rule 33).
  isSystem Boolean @default(false) @map("is_system")

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  rules         NotificationEventRule[]
  notifications Notification[]

  @@id([orgId, templateId])
  /// Answers the specification's open question on template-code uniqueness
  /// scope: one code per channel per organization, so the same logical message
  /// can have an SMS and an in-app variant under one code (Rule 35, Scenario 7).
  @@unique([orgId, code, channel])
  @@unique([orgId, name])
  @@index([orgId, eventType, status])
  @@map("notification_templates")
}

/// A rule mapping an authoritative source event to recipients, a channel and a
/// template (Rules 41, 42).
///
/// This model was `NotificationTrigger`, a four-column stub that predated the
/// specification and that no service ever wrote to. It is renamed rather than
/// left beside a new table, because a permanently dead lookalike is worse than
/// a rename.
model NotificationEventRule {
  orgId  String @map("org_id") @db.Uuid
  ruleId String @default(uuid()) @map("rule_id") @db.Uuid

  name String @db.VarChar(150)

  /// A branch-scoped rule fires only for events in that branch; null fires for
  /// every branch in the organization (Rules 34, 41; Scenario 41).
  branchId String? @map("branch_id") @db.Uuid

  eventType NotificationEvent @map("event_type")

  /// The (module, trigger) pair this rule claims to listen to. Validated
  /// server-side against a whitelist so an unsupported combination cannot be
  /// activated (Scenario 15).
  sourceModule  String @map("source_module") @db.VarChar(50)
  sourceTrigger String @map("source_trigger") @db.VarChar(100)

  recipientStrategy        NotificationRecipientStrategy @map("recipient_strategy")
  /// Required by ROLE. Enforced by a CHECK constraint, not just by validation,
  /// because a rule that cannot resolve anybody is Scenario 53 lying in wait.
  recipientRoleCode        String?                       @map("recipient_role_code") @db.VarChar(50)
  /// Required by BRANCH_USER_GROUP — every active user in the branch holding it.
  recipientPermissionCode  String?                       @map("recipient_permission_code") @db.VarChar(100)
  /// Required non-empty by EXPLICIT.
  explicitRecipientUserIds String[]                      @map("explicit_recipient_user_ids") @db.Uuid

  channel    NotificationChannel
  templateId String              @map("template_id") @db.Uuid

  priority NotificationPriority @default(NORMAL)

  /// A mandatory notification ignores personal preferences entirely (Rules 47,
  /// 48; Scenario 17). Copied onto each `Notification` at creation so preference
  /// evaluation never has to join back to the rule.
  isMandatory Boolean @default(false) @map("is_mandatory")

  /// Retry policy, configured rather than hard-coded (Rules 19-21). Backoff is
  /// `backoffBaseSeconds * 2^(attempt-1)`, deterministic and without jitter,
  /// because Rule 21 asks for predictability over load-spreading.
  maxAttempts        Int @default(5) @map("max_attempts")
  backoffBaseSeconds Int @default(60) @map("backoff_base_seconds")

  sendImmediately     Boolean @default(true) @map("send_immediately")
  scheduledOffsetDays Int?    @map("scheduled_offset_days")

  isActive Boolean @default(true) @map("is_active")
  version  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?              @relation(fields: [orgId, branchId], references: [orgId, branchId])
  template     NotificationTemplate @relation(fields: [orgId, templateId], references: [orgId, templateId])

  @@id([orgId, ruleId])
  @@unique([orgId, name])
  /// The ingestion lookup.
  @@index([orgId, eventType, isActive])
  @@index([orgId, templateId])
  @@map("notification_event_rules")
}

/// One notification to one recipient — the row a user sees in their bell.
///
/// Two properties of this table are load-bearing and easy to undo by accident:
///
///  * `title` and `message` are *rendered and frozen at creation*, not resolved
///    at read time from the template. That is the whole of Rule 40 and Scenario
///    8: an administrator editing a template must not retroactively rewrite
///    what was already communicated. `templateVersion` records which version
///    produced them.
///  * `readStatus` lives on this row, and this row belongs to exactly one
///    recipient. That is what makes Scenario 4 — User A marking read while User
///    B's copy stays unread — structurally true rather than something the
///    service has to remember to enforce (Rules 51, 52).
model Notification {
  orgId          String @map("org_id") @db.Uuid
  notificationId String @default(uuid()) @map("notification_id") @db.Uuid

  /// The authoritative event this was generated from (Scenario 22). Nullable so
  /// a notification raised outside the event pipeline is representable.
  eventId String? @map("event_id") @db.Uuid
  ruleId  String? @map("rule_id") @db.Uuid

  eventType  NotificationEvent @map("event_type")
  /// Denormalised from the event so branch scoping is an indexed predicate
  /// rather than a three-table join (Rules 2, 4; Scenarios 40, 42). Copied at
  /// creation and never re-derived.
  branchId   String?           @map("branch_id") @db.Uuid
  sourceType String?           @map("source_type") @db.VarChar(50)
  sourceId   String?           @map("source_id") @db.Uuid

  recipientUserId       String? @map("recipient_user_id") @db.Uuid
  /// Unused. Module 16's audience is internal staff only; the column is kept
  /// nullable so borrower notifications can be added later without a migration.
  recipientCustomerId   String? @map("recipient_customer_id") @db.Uuid
  /// What roles the recipient held when resolution selected them — the evidence
  /// of what Rule 3's point-in-time resolution actually saw.
  recipientRoleSnapshot String? @map("recipient_role_snapshot") @db.VarChar(200)

  templateId      String? @map("template_id") @db.Uuid
  templateVersion Int?    @map("template_version")

  title   String @db.VarChar(250)
  message String

  /// SHA-256 of the rendered content, so an audit can show it was not altered.
  /// Note for callers: `AuditService.sanitizeMetadata` drops any metadata key
  /// matching /hash/, so this value must be reported under a key such as
  /// `contentDigest` rather than `payloadHash`.
  renderedPayloadHash String? @map("rendered_payload_hash") @db.VarChar(64)

  priority    NotificationPriority @default(NORMAL)
  isMandatory Boolean              @default(false) @map("is_mandatory")

  status            NotificationStatus @default(CREATED)
  /// Set when `status` is SUPPRESSED: USER_PREFERENCE, INACTIVE_RECIPIENT,
  /// INACTIVE_TEMPLATE or NO_ELIGIBLE_RECIPIENT. A suppressed notification is a
  /// created row rather than a silent drop precisely so Scenario 20's "records
  /// the suppression outcome" has somewhere to be recorded.
  suppressionReason String?            @map("suppression_reason") @db.VarChar(100)

  /// Per-recipient read state (Rules 51, 52; Scenarios 3, 4).
  readStatus Boolean   @default(false) @map("read_status")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  /// Soft archival only (Rule 71, Scenario 46). Neither this row nor its
  /// delivery attempts are ever hard-deleted (Rule 70, Scenario 47).
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  /// Kept distinct from each other and from the event's `occurredAt`, because
  /// Rule 67 requires event time and processing times be separately preserved.
  queuedAt    DateTime? @map("queued_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization             @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch            Branch?                  @relation(fields: [orgId, branchId], references: [orgId, branchId])
  event             NotificationSourceEvent? @relation(fields: [orgId, eventId], references: [orgId, eventId])
  recipientUser     User?                    @relation(fields: [orgId, recipientUserId], references: [orgId, userId])
  recipientCustomer Customer?                @relation(fields: [orgId, recipientCustomerId], references: [orgId, customerId])
  template          NotificationTemplate?    @relation(fields: [orgId, templateId], references: [orgId, templateId])

  deliveries NotificationDelivery[]

  @@id([orgId, notificationId])
  /// The notification centre and bell-badge query. `readStatus` is a column
  /// rather than a derived join precisely so this index can exist.
  @@index([orgId, recipientUserId, readStatus, createdAt])
  @@index([orgId, branchId, createdAt])
  @@index([orgId, eventId])
  @@index([orgId, status])
  @@index([orgId, eventType])
  @@map("notifications")
}

/// One attempt to deliver one notification through one channel (Rule 15).
///
/// Attempts are a separate table rather than a counter on `Notification`
/// because Rules 19-21 need each attempt's provider response, failure
/// classification and scheduled retry preserved independently.
model NotificationDelivery {
  orgId          String @map("org_id") @db.Uuid
  deliveryId     String @default(uuid()) @map("delivery_id") @db.Uuid
  notificationId String @map("notification_id") @db.Uuid

  channel       NotificationChannel
  attemptNumber Int                 @map("attempt_number")

  /// The canonical status (Rule 18). For EMAIL and SMS a successful provider
  /// call maps to ACCEPTED_BY_PROVIDER, never DELIVERED — see the enum.
  status   NotificationDeliveryStatus
  provider String?                    @db.VarChar(50)

  providerMessageId String? @map("provider_message_id") @db.VarChar(200)
  /// The provider's own status string, preserved verbatim alongside the
  /// canonical one so mapping never loses the original response (Rule 18).
  providerStatus    String? @map("provider_status") @db.VarChar(100)

  /// Classification that decides retryable versus permanent (Rules 19, 20;
  /// Scenarios 28, 29): SMTP_5XX, SMTP_4XX, PROVIDER_TIMEOUT, INVALID_RECIPIENT,
  /// MISSING_CONTACT.
  failureCode   String? @map("failure_code") @db.VarChar(100)
  /// The specification's `failure_message`.
  failureReason String? @map("failure_reason")

  attemptedAt DateTime  @map("attempted_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  /// Set only when `status` is RETRY_SCHEDULED.
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  notification Notification @relation(fields: [orgId, notificationId], references: [orgId, notificationId], onDelete: Cascade)

  @@id([orgId, deliveryId])
  /// Rule 13 and Scenario 24: a retry is a new attempt number under the *same*
  /// logical notification, and two dispatchers racing on the same attempt
  /// collide here — before either calls a provider — rather than sending twice.
  @@unique([orgId, notificationId, channel, attemptNumber])
  @@index([orgId, notificationId])
  /// The retry sweep.
  @@index([orgId, status, nextRetryAt])
  @@map("notification_deliveries")
}

/// One user's personal notification preferences (Rules 46, 49, 50).
///
/// Preferences only ever suppress *optional* notifications. A rule marked
/// mandatory is evaluated without reading this row at all, which makes it
/// impossible for a preference to override one (Rules 47, 48; Scenario 17).
model NotificationPreference {
  orgId        String @map("org_id") @db.Uuid
  preferenceId String @default(uuid()) @map("preference_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  inAppEnabled Boolean @default(true) @map("in_app_enabled")
  emailEnabled Boolean @default(true) @map("email_enabled")
  smsEnabled   Boolean @default(true) @map("sms_enabled")

  /// The specification's nine event categories as a flat boolean map. A row per
  /// category would be nine writes per save and buys no query benefit, because
  /// evaluation always reads the whole record for one user.
  eventPreferences Json @default("{}") @map("event_preferences")

  /// Optimistic concurrency (Rules 65, 66; Scenarios 21, 51). An update carries
  /// the version it read; a mismatch is a 409 carrying the current server state
  /// rather than a silent overwrite of a newer change made on another device.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)

  @@id([orgId, preferenceId])
  @@unique([orgId, userId])
  @@map("notification_preferences")
}

// ============================================================================
// 28. REPORTS
// ============================================================================

/// A saved report definition — a stored filter set, not a stored result.
///
/// Module 15 added six columns to what was an unused four-column stub. Each one
/// exists because a scenario needs it and a JSON blob could not serve it:
///
///  * `ownerUserId` and `visibility` are queried, not just displayed. Scenario
///    39 returns "only reports visible to that user", which is a WHERE clause —
///    inside `filters` it would be a full scan and a post-filter in JavaScript,
///    which is the shape every scope rule in this codebase forbids.
///  * `branchId` is the *saved* scope and is nullable for organization-wide
///    definitions. It is never trusted at run time: Rules 4 and 27 make the
///    runner's live authorization decide, so this narrows and never widens.
///  * `filters`, `dateBasis`, `fromDate` and `toDate` are the request the
///    definition replays. `dateBasis` is a plain string rather than an enum
///    because the permitted set is per-category and enforced in the service;
///    a database enum would have to be migrated every time a category gained a
///    basis.
///  * `version` is what makes Scenario 59 possible. Two editors saving the same
///    definition must not silently overwrite each other, and optimistic
///    concurrency needs a column to compare.
///
/// `lastRunAt` is the one field a *read* writes. That is not a violation of
/// "reports never modify source data" (Rule 6): the definition is Module 15's
/// own record, not a loan or a ledger entry.
model ReportDefinition {
  orgId              String           @map("org_id") @db.Uuid
  reportDefinitionId String           @default(uuid()) @map("report_definition_id") @db.Uuid
  code               String           @db.VarChar(100)
  name               String           @db.VarChar(150)
  reportType         ReportType       @map("report_type")
  status             RecordStatus
  ownerUserId        String?          @map("owner_user_id") @db.Uuid
  visibility         ReportVisibility @default(PRIVATE)
  /// Saved branch scope. Null means organization-wide as saved; the runner's
  /// own scope still narrows it at run time.
  branchId           String?          @map("branch_id") @db.Uuid
  /// The saved request. Category-specific filters only — never org or branch,
  /// which have their own columns and their own server-side enforcement.
  filters            Json?
  dateBasis          String?          @map("date_basis") @db.VarChar(40)
  fromDate           DateTime?        @map("from_date") @db.Date
  toDate             DateTime?        @map("to_date") @db.Date
  lastRunAt          DateTime?        @map("last_run_at") @db.Timestamptz(6)
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  owner        User?        @relation("ReportDefinitionOwner", fields: [orgId, ownerUserId], references: [orgId, userId])
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])

  runs ReportRun[]

  @@id([orgId, reportDefinitionId])
  @@unique([orgId, code])
  @@index([orgId, ownerUserId])
  @@index([orgId, visibility, status])
  @@map("report_definitions")
}

model ReportRun {
  orgId              String          @map("org_id") @db.Uuid
  reportRunId        String          @default(uuid()) @map("report_run_id") @db.Uuid
  reportDefinitionId String          @map("report_definition_id") @db.Uuid
  requestedBy        String          @map("requested_by") @db.Uuid
  filters            Json
  status             ReportRunStatus
  fileRef            String?         @map("file_ref")
  failureReason      String?         @map("failure_reason")
  startedAt          DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization     @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  reportDefinition ReportDefinition @relation(fields: [orgId, reportDefinitionId], references: [orgId, reportDefinitionId])
  requestedByUser  User             @relation(fields: [orgId, requestedBy], references: [orgId, userId])

  deliveries ReportDelivery[]

  @@id([orgId, reportRunId])
  @@index([orgId, reportDefinitionId])
  @@index([orgId, status])
  @@map("report_runs")
}

model ReportDelivery {
  orgId            String               @map("org_id") @db.Uuid
  reportDeliveryId String               @default(uuid()) @map("report_delivery_id") @db.Uuid
  reportRunId      String               @map("report_run_id") @db.Uuid
  deliveryType     ReportDeliveryType   @map("delivery_type")
  recipient        String?
  status           ReportDeliveryStatus
  failureReason    String?              @map("failure_reason")
  sentAt           DateTime?            @map("sent_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  reportRun    ReportRun    @relation(fields: [orgId, reportRunId], references: [orgId, reportRunId], onDelete: Cascade)

  @@id([orgId, reportDeliveryId])
  @@index([orgId, reportRunId])
  @@map("report_deliveries")
}

// ============================================================================
// MASTER DATA
// ============================================================================

/// Admin-maintained option lists — the values behind dropdowns that a business
/// admin should be able to change without a deploy.
///
/// One generic table rather than a table per list. `category` is a VarChar with
/// its allowed set defined in code (`MASTER_DATA_CATEGORIES` in
/// `@lms/validation`), not a Prisma enum, because adding a category must not
/// require a migration — which is the entire reason this table is generic.
///
/// This covers the fields that are unconstrained strings today: customer
/// `gender`, guarantor `relationship`, loan `purpose`, and the `documentType`
/// that appears in three models with its allowed values hardcoded into DTOs.
///
/// Values that are code-defined rather than admin-defined — loan type, interest
/// type, every lifecycle status — deliberately do NOT live here. They are zod
/// enums in `@lms/validation`, because a new status is a change to business
/// logic that must ship with the code that handles it, not a row somebody adds.
model MasterDataValue {
  orgId    String @map("org_id") @db.Uuid
  valueId  String @default(uuid()) @map("value_id") @db.Uuid
  category String @db.VarChar(50)

  /// Stored in the business column. Immutable after creation: existing rows
  /// carry it as a value, so editing it would silently orphan them.
  code  String @db.VarChar(50)
  /// Displayed. Freely editable — that is the point of the table.
  label String @db.VarChar(200)

  /// Explicit ordering. Option lists elsewhere render in array order, which is
  /// not something an admin can control once the list is data.
  displayOrder Int @default(0) @map("display_order")

  status RecordStatus @default(ACTIVE)

  /// Seeded rows that business logic depends on — the KYC document categories
  /// the completeness check iterates, for example. They may be deactivated or
  /// relabelled but never deleted: removing `ID` would silently break KYC.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@id([orgId, valueId])
  @@unique([orgId, category, code])
  @@index([orgId, category, status, displayOrder])
  @@map("master_data_values")
}

// ============================================================================
// 28. SETTINGS, AUDIT & MAINTENANCE (Module 17)
//
// Scope note that applies to every model below: `branchId` NULL means
// organization-wide, not "unknown" (Rules 1, 2, 34). Because Postgres treats
// NULLs as distinct in a unique index, a plain `@@unique([orgId, branchId, x])`
// would NOT de-duplicate the organization-wide rows. Every table here that
// needs scope uniqueness therefore relies on TWO PARTIAL UNIQUE INDEXES
// declared in raw SQL, which Prisma cannot express and will not show in a diff.
// See migration 20260828120000_settings_audit_maintenance.
// ============================================================================

/// One configured setting value, at organization or branch scope.
///
/// The table is generic — `settingCode` + `valueJson` — but what may be written
/// to it is NOT. Every code must exist in `SETTING_DEFINITIONS` in
/// `@lms/validation`, which owns its value type, scope, protected flag,
/// approval requirement and zod validator. An unknown code is a 400, never a
/// row. That registry is how Rules 8 and 9 ("only settings defined by the LMS
/// configuration model", "no arbitrary key/value through the UI") are enforced
/// without a migration per setting.
///
/// Note what is deliberately ABSENT: there is no `requires_approval` column,
/// despite the spec table dump listing one. Maker-checker is a property of the
/// code in the registry, and a column would be a second source of truth that an
/// operator could flip to bypass approval — which is precisely what Rule 43
/// exists to prevent. `isProtected` IS stored, because it gates read masking on
/// a row already fetched and is not an authorization decision.
model Setting {
  orgId     String @map("org_id") @db.Uuid
  settingId String @default(uuid()) @map("setting_id") @db.Uuid

  /// Null = organization-wide. See the section note on partial unique indexes:
  /// uniqueness is `settings_org_code_key` + `settings_branch_code_key`, NOT an
  /// `@@unique` here. Adding one would create a weaker constraint that permits
  /// duplicate organization-scoped codes (Scenario 5).
  branchId String? @map("branch_id") @db.Uuid

  /// Must resolve in SETTING_DEFINITIONS. Immutable after creation — existing
  /// rows are addressed by it, so editing it would orphan them.
  settingCode     String           @map("setting_code") @db.VarChar(100)
  settingCategory String           @map("setting_category") @db.VarChar(50)
  valueType       SettingValueType @map("value_type")

  /// The value itself. Validated against the registry zod schema before it is
  /// written, and again before a change request is applied (Rules 10, 11).
  valueJson Json @map("value_json")

  /// DATE-only, Asia/Kolkata business-date semantics (Rules 16, 17).
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  status SettingStatus @default(ACTIVE)

  /// Optimistic lock. Every update is a conditional `updateMany` on this value;
  /// `count === 0` is the concurrency conflict of Scenarios 7 and 48. History
  /// lives in `audit_logs.old_data/new_data`, not in a shadow table.
  version Int @default(1)

  /// Snapshot of the registry protected flag, for list rendering and read
  /// masking. The registry remains authoritative for the *authorization*
  /// decision (Scenario 64) — this column must never be read to decide whether
  /// an edit is permitted.
  isProtected Boolean @default(false) @map("is_protected")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])

  changeRequests SettingChangeRequest[]

  @@id([orgId, settingId])
  @@index([orgId, settingCategory, status])
  @@index([orgId, settingCode])
  @@map("settings")
}

/// A proposed change to a setting whose code requires maker-checker approval.
///
/// The active `Setting` row is NOT touched while a request is pending — that is
/// Scenario 9 ("the existing active configuration remains effective until
/// approval"). `baseVersion` is re-checked at apply time, so a setting that
/// moved between submission and approval fails the request rather than
/// clobbering the newer value (Scenario 63).
model SettingChangeRequest {
  orgId           String @map("org_id") @db.Uuid
  changeRequestId String @default(uuid()) @map("change_request_id") @db.Uuid

  /// Human-facing sequential reference, allocated per organization.
  changeRequestNumber String @map("change_request_number") @db.VarChar(30)

  branchId String? @map("branch_id") @db.Uuid

  /// Null when the request proposes the FIRST value for a code, so there is no
  /// setting row to point at yet.
  settingId   String? @map("setting_id") @db.Uuid
  settingCode String  @map("setting_code") @db.VarChar(100)

  requestedValueJson Json @map("requested_value_json")

  /// The `Setting.version` the proposal was built against. Re-checked at apply
  /// time. Zero when the request creates the setting.
  baseVersion Int @map("base_version")

  /// The version that resulted from applying it. Null until APPLIED.
  resultVersion Int? @map("result_version")

  /// Mandatory (Rule 41, and the Mandatory Field Validation outline).
  changeReason String @map("change_reason")

  status SettingChangeStatus @default(PENDING_APPROVAL)

  requestedBy String   @map("requested_by") @db.Uuid
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  /// The approver is refused when equal to `requestedBy` (Scenario 11). There
  /// is deliberately no policy escape hatch for self-approval.
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)

  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")

  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  /// Why an APPROVED request nevertheless failed to activate (Scenario 63).
  failureReason String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])
  setting      Setting?     @relation(fields: [orgId, settingId], references: [orgId, settingId])

  @@id([orgId, changeRequestId])
  @@unique([orgId, changeRequestNumber])
  @@index([orgId, status, submittedAt])
  @@index([orgId, settingCode])
  @@map("setting_change_requests")
}

/// The business calendar for an organization or a branch — working days,
/// holidays and the EOD window.
///
/// This table is what finally answers the TODO in
/// `notifications/scheduled/reminder-scheduler.service.ts`, which records that
/// no calendar exists anywhere in the schema and that reminders therefore fire
/// on holidays.
///
/// `timezone` is stored but only `Asia/Kolkata` is accepted (Rule 16). Storing
/// the column and refusing every other value is more honest than hardcoding:
/// the refusal is visible, and widening it later is a deliberate change.
model BusinessCalendar {
  orgId      String @map("org_id") @db.Uuid
  calendarId String @default(uuid()) @map("calendar_id") @db.Uuid

  /// Null = the organization default. One calendar per scope, enforced by the
  /// partial unique indexes named in the section note.
  branchId String? @map("branch_id") @db.Uuid

  name     String @db.VarChar(150)
  timezone String @default("Asia/Kolkata") @db.VarChar(40)

  /// ISO weekday numbers that are working days: 1 = Monday .. 7 = Sunday.
  /// An array rather than seven booleans so "which days are working" is one
  /// value to validate and one value to diff in the audit trail.
  workingDays Int[] @map("working_days")

  /// Local "HH:MM" within `timezone`. Stored as text, not time-of-day, because
  /// they are a *policy* window rather than an instant, and Rule 17 forbids
  /// introducing timestamp semantics into business-date configuration.
  /// `eodWindowEnd > eodWindowStart` is enforced in the service (Scenario 20).
  eodWindowStart String? @map("eod_window_start") @db.VarChar(5)
  eodWindowEnd   String? @map("eod_window_end") @db.VarChar(5)

  /// Whether a completed EOD may be re-run for the same business date under the
  /// controlled-retry workflow (Scenario 24).
  allowControlledRerun Boolean @default(true) @map("allow_controlled_rerun")

  status  RecordStatus @default(ACTIVE)
  version Int          @default(1)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])

  holidays CalendarHoliday[]

  @@id([orgId, calendarId])
  @@index([orgId, status])
  @@map("business_calendars")
}

/// A non-working date on a calendar. DATE-only, Asia/Kolkata (Rule 16).
model CalendarHoliday {
  orgId      String @map("org_id") @db.Uuid
  holidayId  String @default(uuid()) @map("holiday_id") @db.Uuid
  calendarId String @map("calendar_id") @db.Uuid

  holidayDate DateTime @map("holiday_date") @db.Date
  name        String   @db.VarChar(150)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  calendar     BusinessCalendar @relation(fields: [orgId, calendarId], references: [orgId, calendarId], onDelete: Cascade)

  @@id([orgId, holidayId])
  @@unique([orgId, calendarId, holidayDate])
  @@index([orgId, calendarId, holidayDate])
  @@map("calendar_holidays")
}

/// One execution of a maintenance operation — EOD included.
///
/// `executionKey` is the ENTIRE duplicate-prevention design (Scenarios 22, 30,
/// 66). Format: `{jobType}:{branchId ?? ORG}:{businessDate}`. Starting a run
/// inserts on this unique constraint and treats P2002 as "already running or
/// already done", returning the existing row idempotently rather than raising.
///
/// `triggerType` is deliberately NOT part of the key: a scheduled run and a
/// manual run for the same scope and business date MUST collide, which is
/// exactly Scenario 66. Changing the key format silently breaks that, so
/// `eod.service.spec.ts` exercises both paths in one test.
///
/// A retry NEVER inserts. It updates this row and increments `attemptNumber`
/// (Scenario 24). `parentJobRunId` exists only for RECOVERY runs that
/// deliberately want a fresh key.
model MaintenanceJobRun {
  orgId    String @map("org_id") @db.Uuid
  jobRunId String @default(uuid()) @map("job_run_id") @db.Uuid

  branchId String? @map("branch_id") @db.Uuid

  jobType String @map("job_type") @db.VarChar(60)

  /// DATE-only Asia/Kolkata business date (Rule 65). Null for jobs that are not
  /// business-date scoped.
  businessDate DateTime? @map("business_date") @db.Date

  triggerType MaintenanceTriggerType @map("trigger_type")

  /// See the model note. Unique per organization.
  executionKey String @map("execution_key") @db.VarChar(200)

  status        MaintenanceJobStatus @default(QUEUED)
  attemptNumber Int                  @default(1) @map("attempt_number")

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  processedCount Int @default(0) @map("processed_count")
  succeededCount Int @default(0) @map("succeeded_count")
  failedCount    Int @default(0) @map("failed_count")

  /// Preserved for authorized investigation (Rule 60). Exposure is gated on
  /// permission at read time (Scenario 27).
  failureCode    String? @map("failure_code") @db.VarChar(60)
  failureSummary String? @map("failure_summary")

  /// Whether the controlled-retry path is permitted. A non-retryable terminal
  /// failure moves to RECOVERY_REQUIRED and no automatic retry continues
  /// (Scenario 31).
  retryable   Boolean   @default(false)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)

  /// Set only on a RECOVERY run deliberately allocated a new execution key.
  parentJobRunId String? @map("parent_job_run_id") @db.Uuid

  /// Null for a SCHEDULED run — there is no human actor (Rule 63).
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])

  steps MaintenanceJobStep[]

  @@id([orgId, jobRunId])
  @@unique([orgId, executionKey])
  @@index([orgId, branchId, jobType, businessDate])
  @@index([orgId, status, createdAt])
  @@map("maintenance_job_runs")
}

/// One step within a maintenance run, materialised from the step registry when
/// the run is created.
///
/// This table is what makes partial-failure recovery real rather than
/// aspirational: a retry skips steps already SUCCEEDED, which is the concrete
/// meaning of "previously completed deterministic work is not duplicated"
/// (Scenario 24) — and it is assertable in a test.
model MaintenanceJobStep {
  orgId     String @map("org_id") @db.Uuid
  jobStepId String @default(uuid()) @map("job_step_id") @db.Uuid
  jobRunId  String @map("job_run_id") @db.Uuid

  /// Resolves in the EOD/maintenance step registry.
  stepCode String @map("step_code") @db.VarChar(60)
  sequence Int

  status MaintenanceStepStatus @default(PENDING)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  processedCount Int @default(0) @map("processed_count")

  failureCode    String? @map("failure_code") @db.VarChar(60)
  failureSummary String? @map("failure_summary")

  organization Organization      @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  jobRun       MaintenanceJobRun @relation(fields: [orgId, jobRunId], references: [orgId, jobRunId], onDelete: Cascade)

  @@id([orgId, jobStepId])
  /// A step runs at most once per run — the skip-on-retry guarantee.
  @@unique([orgId, jobRunId, stepCode])
  @@index([orgId, jobRunId, sequence])
  @@map("maintenance_job_steps")
}

/// Maintenance-mode state for an organization or a single branch.
///
/// Enforcement lives in `MaintenanceModeGuard`, registered as the LAST global
/// guard — after authentication and authorization. That ordering is what makes
/// Rule 78 and Scenario 33 structural: a request blocked by maintenance mode has
/// already been authenticated and authorized, so maintenance mode can only ever
/// subtract access, never grant it.
model MaintenanceMode {
  orgId             String @map("org_id") @db.Uuid
  maintenanceModeId String @default(uuid()) @map("maintenance_mode_id") @db.Uuid

  /// Null = the whole organization. A branch row restricts only that branch,
  /// leaving every other branch governed by its own state (Scenario 34).
  branchId String? @map("branch_id") @db.Uuid

  enabled Boolean @default(false)

  /// Mandatory when enabling (Rule 77).
  reason String

  enabledBy     String?   @map("enabled_by") @db.Uuid
  enabledAt     DateTime? @map("enabled_at") @db.Timestamptz(6)
  expectedEndAt DateTime? @map("expected_end_at") @db.Timestamptz(6)

  disabledBy String?   @map("disabled_by") @db.Uuid
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)

  /// Permission codes that may continue to operate while enabled. This is an
  /// ALLOW-list layered on top of normal authorization, never a substitute for
  /// it — holding one of these does not grant the underlying permission.
  allowedPermissions String[] @map("allowed_permissions")

  /// Route prefixes refused while enabled. Empty means "every mutation".
  blockedOperations String[] @map("blocked_operations")

  /// Shown in the controlled failure response (Rule 79, Scenario 32).
  userMessage String? @map("user_message")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])

  @@id([orgId, maintenanceModeId])
  @@index([orgId, enabled])
  @@map("maintenance_modes")
}

/// A data retention / archival policy (Scenarios 55-58).
///
/// # Organization-scoped, with no `branchId`
///
/// The spec's field list names `organization_id` and no branch column, and that
/// is the right shape: retention answers a compliance question about a RECORD
/// CATEGORY, and the categories here (audit logs, ledger and journal entries)
/// are not branch-partitioned in a way that would let one branch keep evidence
/// a shorter time than another. Following the `Guarantor` precedent, the column
/// is absent rather than present-and-ignored, so a per-branch policy cannot be
/// expressed at all instead of being expressible and unenforced.
///
/// # `immutableEvidence` is the purge block, and it is a stored column
///
/// Rule 76 forbids purging financial, ledger or audit evidence that retention
/// still requires. That check must not read the *category* to decide — a future
/// category would default to purgeable, which is the wrong direction to fail.
/// The flag is stored per policy, set at creation from the category, and the
/// purge path refuses any policy carrying it (Scenario 58).
///
/// # Why there is no `lastRunAt` or `recordsPurged` column
///
/// Those describe an execution, not a policy, and belong to the maintenance job
/// that performed it — where they are already audited per run. A column here
/// would be a second source of truth that a failed run leaves permanently
/// wrong, the same reasoning that kept `EXPIRED` off `SettingStatus`.
model RetentionPolicy {
  orgId             String @map("org_id") @db.Uuid
  retentionPolicyId String @default(uuid()) @map("retention_policy_id") @db.Uuid

  /// Human-facing name. Not an identifier — `recordCategory` is what the
  /// retention code matches on.
  name String @db.VarChar(200)

  /// One ACTIVE policy per category per organization. Enforced by the partial
  /// unique index `retention_policies_org_category_active_key`, NOT by an
  /// `@@unique` here — Prisma cannot express `WHERE status = 'ACTIVE'`, and a
  /// plain `@@unique` would be a *stronger* constraint that blocks the
  /// deactivate-then-replace path of Scenario 56. Two active policies for one
  /// category would make "which retention applies" ambiguous, and an arbitrary
  /// tie-break is not a compliance answer.
  recordCategory RetentionRecordCategory @map("record_category")

  /// Mandatory. How long a record must be preserved before any action.
  retentionPeriodDays Int @map("retention_period_days")

  /// Optional. Null = never archived, which is not the same as "archive at 0".
  archiveAfterDays Int? @map("archive_after_days")

  /// Optional. Null = never purged. A purge that would run before
  /// `retentionPeriodDays` is refused at write time, not at purge time — an
  /// impossible policy should never become ACTIVE (Scenario 55).
  purgeAfterDays Int? @map("purge_after_days")

  /// Rule 76. When true the purge path refuses this category outright,
  /// regardless of the day counts above (Scenario 58).
  immutableEvidence Boolean @default(false) @map("immutable_evidence")

  /// Whether records in this category can carry a legal hold. A hold blocks
  /// purge for the held record even when the policy would otherwise allow it.
  legalHoldSupported Boolean @default(false) @map("legal_hold_supported")

  status RetentionPolicyStatus @default(ACTIVE)

  /// Set once the policy has governed real processing. This is what makes
  /// deletion blocked rather than silently destructive (Scenario 56):
  /// deactivate or replace, never delete a policy that has been applied.
  referencedAt DateTime? @map("referenced_at") @db.Timestamptz(6)

  /// Optimistic lock, matching `Setting`. Every update is a conditional
  /// `updateMany`; `count === 0` is the concurrency conflict.
  version Int @default(1)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@id([orgId, retentionPolicyId])
  @@index([orgId, status])
  @@index([orgId, recordCategory, status])
  @@map("retention_policies")
}
