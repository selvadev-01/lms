/// Reachable through Module 08: DRAFT -> SUBMITTED -> UNDER_REVIEW ->
/// APPROVED -> SANCTIONED -> CUSTOMER_ACCEPTED -> AGREEMENT_SIGNED, with
/// MORE_INFO_REQUIRED and REJECTED branching off the review states.
///
/// Four values are deliberately never written:
///
/// - CUSTOMER_REJECTED — Module 08 Rule 13 unifies an admin rejection and a
///   customer's decline of the sanction letter into one REJECTED status
///   carrying a separate reason. A second terminal status would fork every
///   consumer of `status = 'REJECTED'` — the list filter, the badge, the
///   "already decided" refusal — which is the drift Rule 13 exists to prevent.
///   A decline is distinguished by its review row's SANCTION reviewType, not
///   by its status. Kept in the enum rather than dropped because removing an
///   enum value is a breaking migration for no gain.
/// - DISBURSEMENT_PENDING, DISBURSED, CLOSED — Module 09's, not this one's.
///
/// AGREEMENT_SIGNED is terminal *here* as a module boundary, not because the
/// business says a signed loan never moves again.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  REJECTED
  APPROVED
  SANCTIONED
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  AGREEMENT_SIGNED
  DISBURSEMENT_PENDING
  DISBURSED
  CLOSED

  @@map("application_status")
}

enum LoanStatus {
  DRAFT
  APPROVED
  SANCTIONED
  AGREEMENT_PENDING
  AGREEMENT_SIGNED
  DISBURSEMENT_PENDING
  ACTIVE
  OVERDUE
  /// Module 13. A non-performing asset. Reached by an authorized action rather
  /// than automatically: the system derives NPA *eligibility* from days past
  /// due, but Rule 29 requires the classification itself be authorized.
  NPA
  LEGAL_ESCALATION
  RESTRUCTURED
  CLOSURE_PENDING
  CLOSED
  /// Module 13. Added so Scenario 41's guard can refuse a state the enum can
  /// hold. No module currently produces it — the transition into foreclosure
  /// is out of Module 13's scope.
  FORECLOSED
  WRITTEN_OFF
  REJECTED

  @@map("loan_status")
}

// `loan_application_documents.status` — referenced as `document_status`.
enum DocumentStatus {
