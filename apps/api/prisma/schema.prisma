// Loan Management System (LMS) — PostgreSQL schema
//
// Source of truth: docs/_shared/Database-Schema.md
//
// Core rules enforced here:
//   - All money is BigInt in paise.
//   - EMI due dates are DATE (@db.Date).
//   - Every table carries org_id; primary keys are composite (org_id, entity_id).
//   - Foreign keys are tenant-safe composites (org_id, entity_id).
//   - No mutable financial balance columns. Balances derive from journal lines.
//
// Features Prisma cannot express live in raw SQL migrations alongside this file:
//   Row-Level Security, deferred journal-balance triggers, append-only grants,
//   and cross-row financial invariants.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

