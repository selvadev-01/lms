// --- Notifications ---

/// How a notification reaches its recipient.
///
/// Module 16 ships three reachable channels. IN_APP is the notification centre
/// and the header bell; it is the only channel whose delivery the LMS itself
/// completes, and therefore the only one that may honestly report DELIVERED.
/// EMAIL goes through SMTP and SMS through the Module 1 gateway — for both, a
/// successful call means the *provider accepted* the message, never that a
/// human received it (Rule 17).
///
/// PUSH and AUTO_CALL predate the specification and no code path can select
/// them. They are kept because dropping a Postgres enum value requires
/// rewriting the type, and the same reasoning already documented on
/// `ReportType` applies here.
enum NotificationChannel {
  SMS
  PUSH
  EMAIL
  AUTO_CALL

  IN_APP

  @@map("notification_channel")
}

/// The authoritative business events a notification may be raised from.
///
/// One value per entry in the specification's Background list, so an event rule
/// maps to a source event by name rather than by a free-text string (Rule 41).
///
/// The first eight values predate Module 16. Where one already names a
/// specification event it is reused rather than duplicated under a new name —
/// `EMI_DUE_TOMORROW`, `EMI_DUE_TODAY` and `RECEIPT_GENERATED` are the reminder
/// and receipt events, and `LOAN_APPROVED`/`LOAN_REJECTED`/`LOAN_CLOSED` are
/// the loan lifecycle ones. `EMI_MISSED` is the first-miss event and stays
/// distinct from `EMI_OVERDUE`, which the Phase 7 sweep raises on a cadence for
/// as long as the instalment remains unpaid: collapsing them would make "notify
/// once when it slips" and "notify again on day 7" indistinguishable.
enum NotificationEvent {
  LOAN_CLOSED
  LOAN_APPROVED
  LOAN_REJECTED
  EMI_DUE_TOMORROW
  EMI_DUE_TODAY
  EMI_MISSED
  PENALTY_ADDED
  RECEIPT_GENERATED

  APPLICATION_SUBMITTED
  APPLICATION_RETURNED
  APPLICATION_REJECTED
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_ESCALATED
  DISBURSAL_COMPLETED
  DISBURSAL_FAILED
  EMI_PARTIALLY_PAID
  EMI_PAID
  EMI_OVERDUE
  RECEIPT_POSTED
  RECEIPT_REVERSED
  FIELD_SYNC_EXCEPTION
  CASH_SHORTAGE
  CASH_EXCESS
  RECOVERY_ASSIGNED
  PROMISE_TO_PAY_REMINDER
  PROMISE_TO_PAY_MISSED
  LOAN_FORECLOSED
  LOAN_WRITTEN_OFF
  NPA_STATE_CHANGED
  SECURITY_ALERT

  @@map("notification_event")
}

/// The logical lifecycle of one notification to one recipient.
///
/// This is the specification's logical status, and it deliberately stops at
/// SENT. Whether an external provider ultimately *delivered* the message is a
/// per-attempt fact recorded on `NotificationDelivery.status`, because one
/// logical notification can have several attempts with different outcomes —
/// collapsing them into a single logical DELIVERED would be exactly the false
/// claim Rule 17 forbids.
///
/// SUPPRESSED is a terminal state reached without any delivery attempt: a
/// disabled user preference (Scenario 20), an inactive template (Scenario 12)
/// or a deactivated recipient. It is a created row rather than a silent drop so
/// the suppression is inspectable — `suppressionReason` records which.
///
/// DELIVERED and PARTIALLY_DELIVERED predate Module 16 and are unreachable;
/// kept because dropping an enum value rewrites the Postgres type.
enum NotificationStatus {
  QUEUED
  PROCESSING
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED

  CREATED
  SENT
  RETRYING
  SUPPRESSED
  ARCHIVED

  @@map("notification_status")
}

/// The canonical outcome of one delivery attempt, mapped from whatever the
/// provider said (Rule 18).
///
/// ACCEPTED_BY_PROVIDER exists because it is the honest terminal status for
/// both external channels today: SMTP's `250 OK` and Twilio's `queued` mean the
/// provider took custody, not that anyone received anything, and Module 16
/// ships no delivery webhooks to learn otherwise (Rule 17, Scenario 27). Should
/// webhooks arrive later they write into `providerStatus` and can promote an
/// attempt to DELIVERED; until then DELIVERED is reachable only for IN_APP,
/// where the LMS itself is the delivery.
///
/// RETRY_SCHEDULED and PERMANENT_FAILURE separate the two failure kinds that
/// Rules 19-21 treat differently: one has a `nextRetryAt`, the other must never
/// be retried again.
enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED

  ACCEPTED_BY_PROVIDER
  RETRY_SCHEDULED
  PERMANENT_FAILURE

  @@map("notification_delivery_status")
}

enum NotificationTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("notification_template_status")
}

/// Superseded by `NotificationRecipientStrategy`.
///
/// These are audience *categories*, which is a different thing from a rule for
/// resolving who to notify: "BRANCH_ADMIN" cannot express "whoever this
/// recovery case is assigned to". No code path selects these values; they are
/// kept only because dropping an enum value rewrites the Postgres type.
enum NotificationRecipientType {
  CUSTOMER
  FIELD_AGENT
  BRANCH_ADMIN
  ORG_ADMIN

  @@map("notification_recipient_type")
}

/// How an event rule resolves the users to notify (Rule 42).
///
/// Every strategy resolves against authoritative live data at processing time
/// and is then filtered by the same two rules, which is the whole reason
/// resolution is centralised: the user must be ACTIVE (Rules 43, 44) and within
/// the event's branch scope (Rules 3, 4).
///
/// ASSIGNED_USER and RECORD_OWNER read the source row itself rather than a
/// value carried in the event payload, because Scenario 16 requires the
/// recipient come from the authoritative assignment — which may have changed
/// between the event and its processing.
enum NotificationRecipientStrategy {
  ROLE
  ASSIGNED_USER
  RECORD_OWNER
  BRANCH_USER_GROUP
  EXPLICIT

  @@map("notification_recipient_strategy")
}

/// How urgently a notification wants attention. Presentation only — it does not
/// change routing, retry or ordering, and is not the same thing as `isMandatory`
/// (which decides whether a preference may suppress delivery at all).
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("notification_priority")
}

/// The ingestion lifecycle of one authoritative source event.
///
/// FAILED means notification *generation* failed — a template that could not
/// render, for instance (Scenario 52). It is recorded on the event rather than
/// swallowed, and it never implies anything about the source transaction, which
/// committed before the event was written and is unaffected (Rule 62).
enum NotificationEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("notification_event_status")
}

/// Which outbound email gateway an organization uses.
///
/// Mirrors `SmsProviderKind`: CONSOLE writes the message to a local log instead
/// of delivering it and refuses to run in production, so notification delivery
/// is exercisable end-to-end without SMTP credentials.
enum EmailProviderKind {
  CONSOLE
  SMTP

  @@map("email_provider_kind")
}

// --- Reports ---

/// What a saved report reports on.
///
/// The first eight values predate Module 15 and are kept because the enum is a
/// Postgres type: dropping a value would require rewriting the type, and no
/// value here has ever been written by application code. They are also not what
/// the specification asks for — they mix a period (WEEKLY) with a subject
/// (LOAN) with an audience (BRANCH), and cannot express "overdue and recovery"
/// at all.
///
/// The eight `CATEGORY_` values are Module 15's vocabulary: one per report
/// surface the module ships, matching `REPORT_CATEGORY` in `@lms/constants`.
/// Prefixed rather than named plainly because `CASH` and `LOAN` are already
/// taken by the legacy half, and a saved report whose type is ambiguous between
/// two vocabularies is worse than a slightly verbose name.
enum ReportType {
  BRANCH
  DAILY_COLLECTION
  WEEKLY
  MONTHLY
  LOAN
  OUTSTANDING
  EMPLOYEE_PERFORMANCE
  CASH

  CATEGORY_DASHBOARD
  CATEGORY_PORTFOLIO
  CATEGORY_APPLICATIONS
  CATEGORY_DISBURSALS
  CATEGORY_COLLECTIONS
  CATEGORY_FIELD_COLLECTIONS
  CATEGORY_OVERDUE_RECOVERY
  CATEGORY_FINANCIAL

  @@map("report_type")
}

/// Who may see a saved report definition.
enum ReportVisibility {
  /// Only the owner.
  PRIVATE
  /// Anyone in the organization holding the category's view permission.
  SHARED

  @@map("report_visibility")
}

enum ReportRunStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("report_run_status")
}

enum ReportDeliveryType {
  PDF
  EXCEL
  EMAIL

  @@map("report_delivery_type")
}

enum ReportDeliveryStatus {
  PENDING
  DELIVERED
  FAILED

  @@map("report_delivery_status")
}

// ---------------------------------------------------------------------------
// Module 17 — Settings, Audit & Maintenance
// ---------------------------------------------------------------------------

/// How a setting's `valueJson` is interpreted. The registry in
/// `@lms/validation` owns the actual zod validator; this enum exists so the
/// stored row is self-describing and the UI can render the right control.
///
/// PAISE is deliberately distinct from INTEGER even though both store a JSON
/// number: it is the type that carries Rules 14/15 (money is integer paise,
/// never floating point) and drives the money-formatted display.
enum SettingValueType {
  STRING
  INTEGER
  PAISE
  BOOLEAN
  DATE
  TIME
  ENUM
  JSON

  @@map("setting_value_type")
}

/// Lifecycle of a `Setting` row.
///
/// The spec's status list also names REJECTED and EXPIRED. Both are omitted on
/// purpose. Rejection is a property of the *change request*, not of the setting
/// it targeted — the setting itself simply never moved. And expiry is derived
/// from `effectiveTo`: a stored EXPIRED flag is a second source of truth that a
/// missed cron run leaves permanently wrong.
enum SettingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE

  @@map("setting_status")
}

/// Lifecycle of a maker-checker configuration change (Scenarios 9-13).
///
/// REJECTED, CANCELLED and APPLIED are terminal: the service refuses every
/// transition out of them, which is what makes Scenario 13 ("rejected
/// configuration cannot be activated") structural rather than a UI omission.
/// FAILED records an apply-time validation failure (Scenario 63) — the request
/// is spent, and the previously active configuration stands.
enum SettingChangeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  APPLIED
  FAILED

  @@map("setting_change_status")
}

/// What caused a maintenance run to exist (Rule 63 — scheduled and manual work
/// must be distinguishable in operational history).
///
/// This is deliberately NOT part of `executionKey`: a scheduled and a manual
/// run for the same scope and business date must collide with each other, which
/// is exactly Scenario 66.
enum MaintenanceTriggerType {
  SCHEDULED
  MANUAL
  RECOVERY

  @@map("maintenance_trigger_type")
}

/// Maintenance run lifecycle (Rule 58 — explicit lifecycle states).
///
/// RECOVERY_REQUIRED is distinct from FAILED: FAILED is retryable through the
/// normal path, RECOVERY_REQUIRED means an operator must intervene and no
/// automatic retry may continue (Scenario 31).
enum MaintenanceJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRY_SCHEDULED
  CANCELLED
  RECOVERY_REQUIRED

  @@map("maintenance_job_status")
}

/// Per-step lifecycle within a maintenance run. SUCCEEDED is what a retry skips
/// — that is the whole of Scenario 24 ("previously completed deterministic work
/// is not duplicated"), and it is checkable rather than assumed.
enum MaintenanceStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED

  @@map("maintenance_step_status")
}

/// What a retention policy governs (Scenario 55, "supported record category").
///
/// A closed enum rather than free text: a policy naming a category the purge
/// code does not understand would be silently inert — configured, ACTIVE, and
/// protecting nothing. Adding a category here is therefore a deliberate act
/// that forces the purge side to handle it.
///
/// LEDGER_ENTRY, JOURNAL_ENTRY and AUDIT_LOG are the immutable-evidence
/// categories of Rule 76. They are listed so a policy can *describe* their
/// retention, never so a purge can shorten it — see `immutableEvidence`.
enum RetentionRecordCategory {
  AUDIT_LOG
  LEDGER_ENTRY
  JOURNAL_ENTRY
  NOTIFICATION_LOG
  MAINTENANCE_JOB
  USER_SESSION
  REPORT_RUN

  @@map("retention_record_category")
}

/// Retention policy lifecycle (Scenarios 55, 57).
///
/// Deliberately NOT the four-state `SettingStatus`: a retention policy has no
/// maker-checker flow, so DRAFT and PENDING_APPROVAL would be states nothing
/// can ever set. Only ACTIVE policies are selected by retention processing;
/// INACTIVE is the sanctioned way to retire one, because deletion is blocked
/// wherever the policy has been referenced (Scenario 56).
enum RetentionPolicyStatus {
  ACTIVE
  INACTIVE

  @@map("retention_policy_status")
}

// ============================================================================
// 3. TENANT / ORGANIZATION
// ============================================================================

model Organization {
  orgId       String             @id @default(uuid()) @map("org_id") @db.Uuid
  name        String             @db.VarChar(200)
  code        String             @unique @db.VarChar(50)
  legalName   String?            @map("legal_name") @db.VarChar(250)
  logoFileRef String?            @map("logo_file_ref")
  status      OrganizationStatus
  timezone    String             @default("Asia/Kolkata") @db.VarChar(64)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Lifecycle audit trail (Module 02, Rules 21-23). Set together when status
  // moves to INACTIVE and cleared on reactivation, so "why is this off?" is
  // answerable from the row without an audit-log query.
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason String?   @map("deactivation_reason") @db.VarChar(500)

  branches                Branch[]
  users                   User[]
  roles                   Role[]
  permissions             Permission[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  leads                   Lead[]
  customers               Customer[]
  customerAddresses       CustomerAddress[]
  customerDocuments       CustomerDocument[]
  customerKycs            CustomerKyc[]
  guarantors              Guarantor[]
  guarantorDocuments      GuarantorDocument[]
  loanProducts            LoanProduct[]
  loanSchemes             LoanScheme[]
  loanSchemeDurations     LoanSchemeDuration[]
  interestConfigs         InterestConfig[]
  loanApplications        LoanApplication[]
  applicationDocuments    LoanApplicationDocument[]
  applicationReviews      LoanApplicationReview[]
  creditAssessments       CreditAssessment[]
  sanctionLetters         SanctionLetter[]
  loans                   Loan[]
  loanGuarantors          LoanGuarantor[]
  repaymentSchedules      RepaymentSchedule[]
  emis                    Emi[]
  disbursements           Disbursement[]
  collections             Collection[]
  collectionAllocations   CollectionAllocation[]
  collectionVerification  CollectionVerification[]
  penaltyRules            PenaltyRule[]
  penaltyRuleOverrides    PenaltyRuleOverride[]
  loanPenaltyOverrides    LoanPenaltyRuleOverride[]
  penalties               Penalty[]
  penaltyActions          PenaltyAction[]
  fieldAssignments        FieldAssignment[]
  fieldAssignmentCusts    FieldAssignmentCustomer[]
  fieldVisits             FieldVisit[]
  offlineSyncItems        OfflineSyncItem[]
  recoveryCases           RecoveryCase[]
  recoveryCaseAssignments RecoveryCaseAssignment[]
  recoveryActions         RecoveryAction[]
  legalNotices            LegalNotice[]
  settlements             Settlement[]
  loanClosures            LoanClosure[]
  nocs                    Noc[]
  receipts                Receipt[]
  accounts                Account[]
  accountDimensions       AccountDimension[]
  journalEntries          JournalEntry[]
  journalLines            JournalLine[]
  expenseCategories       ExpenseCategory[]
  expenses                Expense[]
  dayClosings             DayClosing[]
  cashBookEntries         CashBookEntry[]
  auditLogs               AuditLog[]
  notificationTemplates   NotificationTemplate[]
  notificationEventRules  NotificationEventRule[]
  notificationEvents      NotificationSourceEvent[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  notificationPrefs       NotificationPreference[]
  emailProviderConfigs    EmailProviderConfig[]
  reportDefinitions       ReportDefinition[]
  reportRuns              ReportRun[]
  reportDeliveries        ReportDelivery[]
  userSessions            UserSession[]
  recoveryRequests        PasswordRecoveryRequest[]
  passwordHistory         PasswordHistory[]
  gpsCheckIns             GpsCheckIn[]
  cashHandovers           CashHandover[]
  cashReconciliations     CashReconciliation[]
  masterDataValues        MasterDataValue[]
  smsProviderConfig       SmsProviderConfig?

  customerMobileVerifications CustomerMobileVerification[]

  /// Module 17.
  settings              Setting[]
  settingChangeRequests SettingChangeRequest[]
  businessCalendars     BusinessCalendar[]
  calendarHolidays      CalendarHoliday[]
  maintenanceJobRuns    MaintenanceJobRun[]
  maintenanceJobSteps   MaintenanceJobStep[]
  maintenanceModes      MaintenanceMode[]
  retentionPolicies     RetentionPolicy[]

  @@map("organizations")
}

model Branch {
  orgId        String       @map("org_id") @db.Uuid
  branchId     String       @default(uuid()) @map("branch_id") @db.Uuid
  code         String       @db.VarChar(50)
  name         String       @db.VarChar(200)
  addressLine1 String       @map("address_line1") @db.VarChar(250)
  addressLine2 String?      @map("address_line2") @db.VarChar(250)
  city         String       @db.VarChar(100)
  state        String       @db.VarChar(100)
  pincode      String       @db.VarChar(10)
  phone        String?      @db.VarChar(30)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  status       BranchStatus
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // See Organization.deactivatedAt — same lifecycle contract.
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason String?   @map("deactivation_reason") @db.VarChar(500)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  users            User[]
  customers        Customer[]
  leads            Lead[]
  loanApplications LoanApplication[]
  loans            Loan[]
  disbursements    Disbursement[]
  collections      Collection[]
  fieldAssignments FieldAssignment[]
  recoveryCases    RecoveryCase[]
  expenses         Expense[]
  dayClosings      DayClosing[]
  cashBookEntries  CashBookEntry[]
  gpsCheckIns      GpsCheckIn[]
  journalEntries   JournalEntry[]

  cashHandovers       CashHandover[]
  cashReconciliations CashReconciliation[]

  /// Module 17. Null on these rows means organization-wide, not "unknown" —
  /// the same contract as the Module 16 relations below (Rules 2, 34).
  settings              Setting[]
  settingChangeRequests SettingChangeRequest[]
  businessCalendars     BusinessCalendar[]
  maintenanceJobRuns    MaintenanceJobRun[]
  maintenanceModes      MaintenanceMode[]

  /// Module 16. The branch a source event, rule or notification belongs to.
  /// Null on those rows means organization-wide, not "unknown" (Rule 2).
  notificationEvents     NotificationSourceEvent[]
  notificationEventRules NotificationEventRule[]
  notifications          Notification[]

  /// Module 15. The branch a saved report definition was scoped to when saved.
  reportDefinitions ReportDefinition[]

  @@id([orgId, branchId])
  @@unique([orgId, code])
  @@map("branches")
}

// ============================================================================
// 4. AUTHENTICATION / RBAC
// ============================================================================

model User {
  orgId               String     @map("org_id") @db.Uuid
  userId              String     @default(uuid()) @map("user_id") @db.Uuid
  branchId            String?    @map("branch_id") @db.Uuid
  employeeCode        String?    @map("employee_code") @db.VarChar(50)
  name                String     @db.VarChar(200)
  email               String?    @db.VarChar(320)
  mobile              String?    @db.VarChar(20)
  passwordHash        String?    @map("password_hash")
  status              UserStatus
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Set whenever the password is established or changed. Lets a reset be
  /// audited (Forgot Password Scenario 39) without recording the password
  /// itself. Null for accounts that have never had a password set.
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch?      @relation(fields: [orgId, branchId], references: [orgId, branchId])

  userRoles         UserRole[]
  sessions          UserSession[]
  recoveryRequests  PasswordRecoveryRequest[]
  passwordHistory   PasswordHistory[]
  collections       Collection[]
  fieldAssignments  FieldAssignment[]
  fieldVisits       FieldVisit[]
  offlineSyncItems  OfflineSyncItem[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  /// Module 16. This user's personal notification preferences (Rules 49, 50).
  notificationPrefs NotificationPreference[]
  reportRuns        ReportRun[]
  gpsCheckIns       GpsCheckIn[]

  /// Module 15. Saved report definitions this user owns. Named because the
  /// relation is optional on the other side and a bare `ReportDefinition[]`
  /// would not say which of its two user-shaped columns it followed.
  reportDefinitions ReportDefinition[] @relation("ReportDefinitionOwner")

  /// Module 12. Named relations because a user appears on each row twice over:
  /// the agent who handed cash over and the branch user who received it are
  /// different people, and the whole control depends on them staying so.
  cashHandoversAsAgent        CashHandover[]       @relation("CashHandoverAgent")
  cashHandoversReceived       CashHandover[]       @relation("CashHandoverReceiver")
  cashReconciliationsAsAgent  CashReconciliation[] @relation("CashReconciliationAgent")
  cashReconciliationsResolved CashReconciliation[] @relation("CashReconciliationResolver")

  /// Module 13. Named for the same reason as Module 12's pairs above: a user
  /// reaches a recovery case as its assignee, its opener and its closer, and a
  /// reassignment names two more people on one history row. Each is a distinct
  /// authority, and the delete blocker has to count all of them — see
  /// `USER_DEPENDENCIES`.
  recoveryCasesAssigned   RecoveryCase[]           @relation("RecoveryCaseAssignee")
  recoveryCasesCreated    RecoveryCase[]           @relation("RecoveryCaseCreatedBy")
  recoveryCasesClosed     RecoveryCase[]           @relation("RecoveryCaseClosedBy")
  recoveryAssignmentsFrom RecoveryCaseAssignment[] @relation("RecoveryAssignmentFrom")
  recoveryAssignmentsTo   RecoveryCaseAssignment[] @relation("RecoveryAssignmentTo")
  recoveryAssignmentsMade RecoveryCaseAssignment[] @relation("RecoveryAssignmentBy")
  recoveryActions         RecoveryAction[]         @relation("RecoveryActionPerformedBy")
  legalNoticesIssued      LegalNotice[]            @relation("LegalNoticeIssuedBy")
  settlementsApproved     Settlement[]             @relation("SettlementApprovedBy")
  settlementsCreated      Settlement[]             @relation("SettlementCreatedBy")

  @@id([orgId, userId])
  @@unique([orgId, email])
  @@unique([orgId, mobile])
  @@unique([orgId, employeeCode])
  @@index([orgId, branchId])
  @@map("users")
}

model Role {
  orgId       String     @map("org_id") @db.Uuid
  roleId      String     @default(uuid()) @map("role_id") @db.Uuid
  code        String     @db.VarChar(100)
  name        String     @db.VarChar(150)
  description String?
  status      RoleStatus
  /// A role the system itself depends on. Cannot be renamed, deactivated,
  /// deleted, or have permissions removed — the guard that stops an
  /// organization from administering away its own last administrator
  /// (Module 03 Rules 25, 26, and the Q-RBAC-17 resolution). Permissions may
  /// still be *added*: the protection is against losing access, not gaining it.
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@id([orgId, roleId])
  @@unique([orgId, code])
  @@map("roles")
}

model Permission {
  orgId        String  @map("org_id") @db.Uuid
  permissionId String  @default(uuid()) @map("permission_id") @db.Uuid
  code         String  @db.VarChar(150)
  module       String  @db.VarChar(100)
  action       String  @db.VarChar(100)
  description  String?

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  rolePermissions RolePermission[]

  @@id([orgId, permissionId])
  @@unique([orgId, code])
  @@unique([orgId, module, action])
  @@map("permissions")
}

model RolePermission {
  orgId        String   @map("org_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  role         Role         @relation(fields: [orgId, roleId], references: [orgId, roleId], onDelete: Cascade)
  permission   Permission   @relation(fields: [orgId, permissionId], references: [orgId, permissionId], onDelete: Cascade)

  @@id([orgId, roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)
  role         Role         @relation(fields: [orgId, roleId], references: [orgId, roleId], onDelete: Cascade)

  @@id([orgId, userId, roleId])
  @@map("user_roles")
}

/// Server-side session record backing cookie authentication.
///
/// The raw refresh token is never stored — only its SHA-256 hash. SHA-256 is
/// correct here rather than a password hash: the token already carries 256 bits
/// of entropy so needs no work factor, and refresh runs on every page load.
///
/// A row is what makes Logout and revocation possible; deleting the cookie
/// alone could not invalidate a session server-side.
model UserSession {
  orgId            String    @map("org_id") @db.Uuid
  sessionId        String    @default(uuid()) @map("session_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(50)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  /// Branch scope captured at sign-in, so a later branch reassignment does not
  /// silently widen an already-issued session.
  branchId         String?   @map("branch_id") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)
  gpsCheckIns  GpsCheckIn[]

  @@id([orgId, sessionId])
  /// Globally unique so a refresh token resolves in one indexed lookup without
  /// the caller having to know its orgId first.
  @@unique([refreshTokenHash])
  @@index([orgId, userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// A password-recovery request raised from the Forgot Password screen.
///
/// Two secrets are held in sequence rather than in parallel, and each is hashed
/// with the algorithm its entropy warrants:
///
///   - `otpHash` is argon2id, because a 6-digit OTP is brute-forceable and needs
///     a work factor.
///   - `resetTokenHash` is SHA-256, because the token is 256 bits of randomness
///     and needs none — the same reasoning as `UserSession.refreshTokenHash`.
///
/// Verifying the OTP is what mints the reset token: the OTP alone is never an
/// authorization to change a password (Scenarios 15, 16, 40).
///
/// The row is deliberately the rate-limiting surface too. `@Throttle` on the
/// endpoint caps requests per IP, but `lastSentAt`/`resendCount` cap them per
/// account, which is what Scenarios 21 and 23 actually require.
model PasswordRecoveryRequest {
  orgId     String @map("org_id") @db.Uuid
  requestId String @default(uuid()) @map("request_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  otpHash        String  @map("otp_hash")
  /// Null until the OTP is verified. Deliberately RETAINED once consumed:
  /// `status` and `consumedAt` are what make the token unusable (Scenario 42),
  /// and keeping the hash lets a replayed token still resolve to its row so the
  /// attempt is audited against the right account (Scenario 34). It is cleared
  /// only when a request is superseded, because the column is globally unique.
  resetTokenHash String? @map("reset_token_hash")

  status RecoveryRequestStatus @default(REQUESTED)

  attemptCount   Int       @default(0) @map("attempt_count")
  resendCount    Int       @default(0) @map("resend_count")
  lastSentAt     DateTime  @map("last_sent_at") @db.Timestamptz(6)
  /// OTP expiry.
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Reset-token expiry, set only once the OTP has been verified.
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)

  @@id([orgId, requestId])
  /// Globally unique so a reset token resolves in one indexed lookup without
  /// the caller having to know its orgId first — the token is all the client
  /// holds at that point.
  @@unique([resetTokenHash])
  @@index([orgId, userId, status])
  @@index([expiresAt])
  @@map("password_recovery_requests")
}

/// Previous password hashes, retained so a reset cannot re-establish a password
/// the user has recently used (Reset Password Scenario 12, Q-PWD-4).
///
/// Stores hashes only — never a plaintext password, and never a reversible
/// encoding of one. Reuse is detected by verifying the candidate against each
/// stored hash, exactly as sign-in verifies a password, so this table leaks
/// nothing that the `users.password_hash` column does not already.
///
/// Rows beyond the configured depth (`AUTH_PASSWORD_HISTORY_DEPTH`) are deleted
/// on each successful change, so the table stays bounded per user rather than
/// growing for the lifetime of the account.
model PasswordHistory {
  orgId     String @map("org_id") @db.Uuid
  historyId String @default(uuid()) @map("history_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)

  @@id([orgId, historyId])
  /// Ordered by recency: every read is "the newest N hashes for this user".
  @@index([orgId, userId, createdAt])
  @@map("password_history")
}

/// One Field Employee GPS check-in attempt — successful or not.
///
/// Every attempt is persisted, including failures, because the story requires a
/// failed attempt to stay recorded as failed after a later success (Scenarios
/// 13-15). Rows are therefore append-only in practice: a retry writes a new row
/// rather than updating the previous one, so a failure can never be rewritten
/// as a success.
///
/// `branchId` is NOT NULL here even though `users.branch_id` is nullable. A GPS
/// check-in is a branch-scoped field operation; an org-wide user (Super Admin)
/// has no branch to check in against, and the service rejects that case rather
/// than inventing one. The value is always taken from the authenticated
/// session's `AuthContext`, never from the request body, which is what makes
/// Scenarios 24 and 26 — GPS cannot move a user's branch or organization —
/// true by construction rather than by validation.
///
/// Coordinates are nullable because a failed attempt legitimately has none: a
/// permission denial or a timeout never produced a position. The verification
/// status, not the presence of coordinates, is what decides whether a location
/// was verified.
model GpsCheckIn {
  orgId     String @map("org_id") @db.Uuid
  checkInId String @default(uuid()) @map("check_in_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid

  /// Client-generated per attempt. The idempotency key that stops a retried
  /// fetch or a double submit from creating two authoritative check-ins
  /// (Scenario 37).
  clientAttemptId String @map("client_attempt_id") @db.Uuid

  /// Decimal(10,7) matches `FieldVisit.latitude`/`longitude` — ~1 cm of
  /// resolution, far beyond what consumer GPS reports.
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  accuracyMeters Decimal? @map("accuracy_meters") @db.Decimal(8, 2)

  /// Device-reported, stored as received. Never used as the authoritative
  /// clock: a device clock is attacker-controlled, so `verifiedAt` below comes
  /// from the server. This column exists so skew is auditable, and a value
  /// outside the freshness window fails the check-in (Q-GPS-11, Q-GPS-12).
  locationTimestamp DateTime? @map("location_timestamp") @db.Timestamptz(6)

  verificationStatus GpsVerificationStatus @default(PENDING) @map("verification_status")
  permissionStatus   GpsPermissionStatus   @default(UNKNOWN) @map("permission_status")
  networkStatus      GpsNetworkStatus      @map("network_status")
  failureReason      GpsFailureReason?     @map("failure_reason")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Server clock, set only on a verified attempt. Null is the single source of
  /// truth for "not verified" alongside `verificationStatus`.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: Cascade)
  branch       Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])
  session      UserSession  @relation(fields: [orgId, sessionId], references: [orgId, sessionId], onDelete: Cascade)

  /// Field collections citing this check-in as their location evidence.
  collections Collection[]

  /// Module 13 recovery activities citing this check-in as their location
  /// evidence, on the same reference-rather-than-copy principle.
  recoveryActions RecoveryAction[]

  @@id([orgId, checkInId])
  /// Per-organization, not global: the id is minted by a client that has
  /// already authenticated into a tenant, so it never has to resolve without
  /// one — unlike a refresh or reset token.
  @@unique([orgId, clientAttemptId])
  /// "This user's attempts, newest first" — the history read.
  @@index([orgId, userId, createdAt])
  /// Branch-scoped supervision reads.
  @@index([orgId, branchId, createdAt])
  /// "Is this user currently verified?" — the gate consulted on every field
  /// operation, so it gets its own covering index.
  @@index([orgId, userId, verificationStatus, verifiedAt])
  @@map("gps_check_ins")
}

// ============================================================================
// 5. CUSTOMER DOMAIN
// ============================================================================

model Lead {
  orgId      String     @map("org_id") @db.Uuid
  leadId     String     @default(uuid()) @map("lead_id") @db.Uuid
  branchId   String     @map("branch_id") @db.Uuid
  name       String?    @db.VarChar(200)
  mobile     String?    @db.VarChar(20)
  source     String?    @db.VarChar(100)
  status     LeadStatus
  referredBy String?    @map("referred_by") @db.VarChar(200)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])

  customers Customer[]

  @@id([orgId, leadId])
  @@index([orgId, branchId])
  @@index([orgId, status])
  @@map("leads")
}

model Customer {
  orgId            String         @map("org_id") @db.Uuid
  customerId       String         @default(uuid()) @map("customer_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  customerCode     String         @map("customer_code") @db.VarChar(50)
  customerType     CustomerType   @map("customer_type")
  leadId           String?        @map("lead_id") @db.Uuid
  fullName         String         @map("full_name") @db.VarChar(200)
  mobile           String         @db.VarChar(20)
  /// Set only by a completed OTP round-trip (Module 04, Scenario 14). A LOCAL
  /// customer cannot reach ACTIVE while this is null, and changing `mobile`
  /// clears it — the verification attaches to the number, not to the customer.
  mobileVerifiedAt DateTime?      @map("mobile_verified_at") @db.Timestamptz(6)
  /// Optional contact address with no verification loop (Q-CUST-25). Mobile is
  /// the verified identity channel; email is never used to authenticate.
  email            String?        @db.VarChar(320)
  dateOfBirth      DateTime?      @map("date_of_birth") @db.Date
  gender           String?        @db.VarChar(30)
  addressLine1     String         @map("address_line1") @db.VarChar(250)
  addressLine2     String?        @map("address_line2") @db.VarChar(250)
  city             String?        @db.VarChar(100)
  state            String?        @db.VarChar(100)
  pincode          String?        @db.VarChar(10)
  status           CustomerStatus
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])
  lead         Lead?        @relation(fields: [orgId, leadId], references: [orgId, leadId])

  addresses            CustomerAddress[]
  documents            CustomerDocument[]
  kycRecords           CustomerKyc[]
  mobileVerifications  CustomerMobileVerification[]
  guarantors           Guarantor[]
  loanApplications     LoanApplication[]
  loans                Loan[]
  collections          Collection[]
  fieldAssignmentCusts FieldAssignmentCustomer[]
  fieldVisits          FieldVisit[]
  notifications        Notification[]

  @@id([orgId, customerId])
  @@unique([orgId, customerCode])
  @@index([orgId, mobile])
  @@index([orgId, fullName])
  @@index([orgId, branchId])
  @@index([orgId, customerType])
  @@index([orgId, status])
  @@map("customers")
}

model CustomerAddress {
  orgId             String   @map("org_id") @db.Uuid
  customerAddressId String   @default(uuid()) @map("customer_address_id") @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  addressType       String   @map("address_type") @db.VarChar(30)
  addressLine1      String   @map("address_line1") @db.VarChar(250)
  addressLine2      String?  @map("address_line2") @db.VarChar(250)
  city              String?  @db.VarChar(100)
  state             String?  @db.VarChar(100)
  pincode           String?  @db.VarChar(10)
  isPrimary         Boolean  @default(false) @map("is_primary")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  customer     Customer     @relation(fields: [orgId, customerId], references: [orgId, customerId], onDelete: Cascade)

  @@id([orgId, customerAddressId])
  @@index([orgId, customerId])
  @@map("customer_addresses")
}

model CustomerDocument {
  orgId              String                     @map("org_id") @db.Uuid
  documentId         String                     @default(uuid()) @map("document_id") @db.Uuid
  customerId         String                     @map("customer_id") @db.Uuid
  documentType       String                     @map("document_type") @db.VarChar(50)
  /// Opaque storage key, never a URL and never a client-supplied filename. The
  /// bytes are only reachable through an endpoint that re-checks scope
  /// (Scenarios 12, 32); nothing static serves this path.
  fileRef            String                     @map("file_ref")
  /// Original upload name, kept for display and for the download filename only.
  fileName           String?                    @map("file_name") @db.VarChar(255)
  /// Decided by magic bytes at upload, not by the client's Content-Type header.
  mimeType           String?                    @map("mime_type") @db.VarChar(100)
  fileSize           Int?                       @map("file_size")
  documentNumber     String?                    @map("document_number") @db.VarChar(100)
  /// Replacement uploads insert a new row at `version + 1` rather than editing
  /// this one, so the superseded copy stays auditable (Scenario 11).
  version            Int                        @default(1)
  supersededAt       DateTime?                  @map("superseded_at") @db.Timestamptz(6)
  uploadedBy         String?                    @map("uploaded_by") @db.Uuid
  verificationStatus DocumentVerificationStatus @map("verification_status")
  /// Why a document was rejected. Required when status becomes REJECTED.
  verificationReason String?                    @map("verification_reason")
  verifiedBy         String?                    @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  customer     Customer     @relation(fields: [orgId, customerId], references: [orgId, customerId], onDelete: Cascade)

  @@id([orgId, documentId])
  @@index([orgId, customerId])
  @@index([orgId, customerId, documentType])
  @@map("customer_documents")
}

model CustomerKyc {
  orgId          String    @map("org_id") @db.Uuid
  kycId          String    @default(uuid()) @map("kyc_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  status         KycStatus
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  revisionReason String?   @map("revision_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  customer     Customer     @relation(fields: [orgId, customerId], references: [orgId, customerId], onDelete: Cascade)

  @@id([orgId, kycId])
  @@index([orgId, customerId])
  @@map("customer_kyc")
}

/// LOCAL customer mobile verification (Module 04, Scenarios 2 and 14).
///
/// A LOCAL customer skips KYC entirely, so the OTP round-trip is the *only*
/// identity evidence the system ever collects for them (Q-CUST-27) — which is
/// why it is a durable, auditable record rather than a transient flag. The
/// outcome is written to `Customer.mobileVerifiedAt`; this table is the trail of
/// how it got there.
///
/// Deliberately mirrors `PasswordRecoveryRequest`: same hashed-OTP storage, same
/// expiry-and-attempt shape. The OTP is never stored in clear text, and the
/// verified number is captured on the row so that changing `Customer.mobile`
/// later cannot silently re-point an old verification at a new number.
model CustomerMobileVerification {
  orgId          String @map("org_id") @db.Uuid
  verificationId String @default(uuid()) @map("verification_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  /// The number this OTP was minted for. Compared against the customer's current
  /// mobile at verify time; a mismatch means the number changed mid-flow and the
  /// verification no longer proves anything.
  mobile  String @db.VarChar(20)
  otpHash String @map("otp_hash")

  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set once the OTP is accepted. A consumed row is never reusable.
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)

  requestedBy String? @map("requested_by") @db.Uuid
  ipAddress   String? @map("ip_address") @db.Inet
  userAgent   String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  customer     Customer     @relation(fields: [orgId, customerId], references: [orgId, customerId], onDelete: Cascade)

  @@id([orgId, verificationId])
  @@index([orgId, customerId])
  @@map("customer_mobile_verifications")
}

// ============================================================================
// 6. GUARANTORS
// ============================================================================

/// A guarantor is a child of exactly one customer (Module 05, Q-GUAR-1..3).
/// The same person standing for two customers is two rows, not one shared
/// record: each relationship carries its own consent, its own KYC and its own
/// authorization context (Rule 46), and merging them would make one customer's
/// consent decision silently apply to another's loan.
///
/// **There is no `branchId` column, deliberately.** Branch scope is read through
/// `customer.branchId`. A denormalized copy is exactly how Rule 10 breaks: a
/// customer moving branch would leave the guarantor pointing at the old one
/// until something remembered to update it.
model Guarantor {
  orgId              String             @map("org_id") @db.Uuid
  guarantorId        String             @default(uuid()) @map("guarantor_id") @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  fullName           String             @map("full_name") @db.VarChar(200)
  mobile             String             @db.VarChar(20)
  address            String?
  /// Relationship to the customer (Module 04 guarantor fields). Free text: the
  /// source names the field but enumerates no values.
  relationship       String?            @db.VarChar(100)
  /// ACTIVE/INACTIVE only. Deactivation is the supported removal path when a
  /// guarantor is referenced downstream (Rules 34, 79; Scenario 28) — it never
  /// touches `loanGuarantors`, so history survives (Rules 35, 38).
  status             GuarantorStatus    @default(ACTIVE) @map("status")
  deactivatedAt      DateTime?          @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason String?            @map("deactivation_reason") @db.VarChar(500)
  consentStatus      ConsentStatus      @map("consent_status")
  /// When consent moved to GIVEN. Null while PENDING or REJECTED — the pair
  /// carries "what was decided" and "when", which Scenario 25 asks for.
  consentAt          DateTime?          @map("consent_at") @db.Timestamptz(6)
  /// Who recorded the consent decision (Rule 23, Scenario 15). Consent here is
  /// staff-recorded, so this is an LMS user, never the guarantor themselves.
  consentBy          String?            @map("consent_by") @db.Uuid
  /// Defaults to NOT_REQUIRED, not PENDING: whether a guarantor needs KYC is a
  /// loan-product rule that does not exist yet (Rule 3, Q-GUAR-11). Defaulting
  /// to PENDING would put every guarantor ever created into a review queue
  /// nobody asked for.
  kycStatus          GuarantorKycStatus @default(NOT_REQUIRED) @map("kyc_status")
  kycSubmittedAt     DateTime?          @map("kyc_submitted_at") @db.Timestamptz(6)
  kycReviewedAt      DateTime?          @map("kyc_reviewed_at") @db.Timestamptz(6)
  kycReviewedBy      String?            @map("kyc_reviewed_by") @db.Uuid
  /// Why a reviewer sent guarantor KYC back (Scenario 23). Retained so the
  /// resubmission knows what to fix.
  kycRevisionReason  String?            @map("kyc_revision_reason")
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Doubles as the optimistic-concurrency token (Scenario 46, Q-GUAR-67). The
  /// API exposes `updatedAt.toISOString()` as `version` and refuses a write
  /// carrying a stale one, matching `Customer`. No separate `version` column:
  /// a second concurrency idiom in one module is how the two drift apart.
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  customer     Customer     @relation(fields: [orgId, customerId], references: [orgId, customerId], onDelete: Cascade)

  documents      GuarantorDocument[]
  loanGuarantors LoanGuarantor[]

  @@id([orgId, guarantorId])
  @@index([orgId, customerId])
  /// The three below drive the org-scoped guarantor directory (GUA-001): status
  /// filter, mobile prefix search and name search. No unique constraint on
  /// (orgId, customerId, mobile) — duplicate detection is a soft flag with a
  /// `force` override (Q-GUAR-4), and a hard constraint would make Scenario 10's
  /// "configured rule" impossible to override.
  @@index([orgId, status])
  @@index([orgId, mobile])
  @@index([orgId, fullName])
  @@map("guarantors")
}

/// Guarantor KYC documents, kept structurally separate from `CustomerDocument`
/// (Rule 18, Scenario 22). Field-for-field the same shape, because the storage
/// and review rules are the same and a reviewer reading one should not have to
/// learn a second model — but a separate table, so borrower KYC approval can
/// never reach a guarantor's documents and vice versa.
model GuarantorDocument {
  orgId              String                     @map("org_id") @db.Uuid
  documentId         String                     @default(uuid()) @map("document_id") @db.Uuid
  guarantorId        String                     @map("guarantor_id") @db.Uuid
  documentType       String                     @map("document_type") @db.VarChar(50)
  /// Opaque storage key, never a URL and never a client-supplied filename. The
  /// bytes are only reachable through an endpoint that re-checks scope; nothing
  /// static serves this path.
  fileRef            String                     @map("file_ref")
  /// Original upload name, kept for display and for the download filename only.
  fileName           String?                    @map("file_name") @db.VarChar(255)
  /// Decided by magic bytes at upload, not by the client's Content-Type header.
  mimeType           String?                    @map("mime_type") @db.VarChar(100)
  fileSize           Int?                       @map("file_size")
  documentNumber     String?                    @map("document_number") @db.VarChar(100)
  /// Replacement uploads insert a new row at `version + 1` rather than editing
  /// this one, so the copy a reviewer's decision referred to stays auditable.
  version            Int                        @default(1)
  supersededAt       DateTime?                  @map("superseded_at") @db.Timestamptz(6)
  uploadedBy         String?                    @map("uploaded_by") @db.Uuid
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  /// Why a document was rejected. Required when status becomes REJECTED.
  verificationReason String?                    @map("verification_reason")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?                    @map("verified_by") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  guarantor    Guarantor    @relation(fields: [orgId, guarantorId], references: [orgId, guarantorId], onDelete: Cascade)

  @@id([orgId, documentId])
  @@index([orgId, guarantorId])
  @@index([orgId, guarantorId, documentType])
  @@map("guarantor_documents")
}

// ============================================================================
// 7. LOAN PRODUCTS / SCHEMES
// ============================================================================

model LoanProduct {
  orgId         String            @map("org_id") @db.Uuid
  loanProductId String            @default(uuid()) @map("loan_product_id") @db.Uuid
  code          String            @db.VarChar(50)
  name          String            @db.VarChar(150)
  loanType      LoanType          @map("loan_type")
  status        LoanProductStatus
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  loanSchemes      LoanScheme[]
  loanApplications LoanApplication[]
  loans            Loan[]

  @@id([orgId, loanProductId])
  @@unique([orgId, code])
  @@map("loan_products")
}

model LoanScheme {
  orgId           String           @map("org_id") @db.Uuid
  loanSchemeId    String           @default(uuid()) @map("loan_scheme_id") @db.Uuid
  loanProductId   String           @map("loan_product_id") @db.Uuid
  code            String           @db.VarChar(50)
  name            String           @db.VarChar(150)
  interestType    InterestType     @map("interest_type")
  interestRateBps BigInt           @map("interest_rate_bps")
  status          LoanSchemeStatus
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loanProduct  LoanProduct  @relation(fields: [orgId, loanProductId], references: [orgId, loanProductId])

  durations            LoanSchemeDuration[]
  loanApplications     LoanApplication[]
  loans                Loan[]
  penaltyRuleOverrides PenaltyRuleOverride[]

  @@id([orgId, loanSchemeId])
  @@unique([orgId, code])
  @@index([orgId, loanProductId])
  @@map("loan_schemes")
}

model LoanSchemeDuration {
  orgId                String             @map("org_id") @db.Uuid
  loanSchemeDurationId String             @default(uuid()) @map("loan_scheme_duration_id") @db.Uuid
  loanSchemeId         String             @map("loan_scheme_id") @db.Uuid
  frequency            RepaymentFrequency
  durationCount        Int                @map("duration_count")
  status               RecordStatus

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loanScheme   LoanScheme   @relation(fields: [orgId, loanSchemeId], references: [orgId, loanSchemeId], onDelete: Cascade)

  @@id([orgId, loanSchemeDurationId])
  @@unique([orgId, loanSchemeId, frequency, durationCount])
  @@map("loan_scheme_durations")
}

// ============================================================================
// 8. INTEREST CONFIGURATION
// ============================================================================

model InterestConfig {
  orgId            String       @map("org_id") @db.Uuid
  interestConfigId String       @default(uuid()) @map("interest_config_id") @db.Uuid
  name             String       @db.VarChar(150)
  interestType     InterestType @map("interest_type")
  rateBps          BigInt       @map("rate_bps")
  effectiveFrom    DateTime     @map("effective_from") @db.Date
  effectiveTo      DateTime?    @map("effective_to") @db.Date
  status           RecordStatus
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@id([orgId, interestConfigId])
  @@index([orgId, effectiveFrom])
  @@map("interest_configs")
}

// ============================================================================
// 9. LOAN APPLICATION
// ============================================================================

model LoanApplication {
  orgId                String             @map("org_id") @db.Uuid
  applicationId        String             @default(uuid()) @map("application_id") @db.Uuid
  applicationNumber    String             @map("application_number") @db.VarChar(50)
  branchId             String             @map("branch_id") @db.Uuid
  customerId           String             @map("customer_id") @db.Uuid
  loanProductId        String             @map("loan_product_id") @db.Uuid
  loanSchemeId         String             @map("loan_scheme_id") @db.Uuid
  requestedAmountPaise BigInt             @map("requested_amount_paise")
  purpose              String?
  interestType         InterestType       @map("interest_type")
  interestRateBps      BigInt             @map("interest_rate_bps")
  repaymentFrequency   RepaymentFrequency @map("repayment_frequency")
  durationCount        Int                @map("duration_count")
  status               ApplicationStatus
  rejectionReason      String?            @map("rejection_reason")
  submittedAt          DateTime?          @map("submitted_at") @db.Timestamptz(6)
  approvedAt           DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvedBy           String?            @map("approved_by") @db.Uuid
  sanctionedAt         DateTime?          @map("sanctioned_at") @db.Timestamptz(6)
  /// When the customer accepted or declined the sanction letter. Mirrored from
  /// `SanctionLetter.customerRespondedAt` so the application row alone tells the
  /// whole lifecycle story without a join, the same way `approvedAt` does.
  customerRespondedAt  DateTime?          @map("customer_responded_at") @db.Timestamptz(6)
  agreementSignedAt    DateTime?          @map("agreement_signed_at") @db.Timestamptz(6)
  createdBy            String?            @map("created_by") @db.Uuid
  updatedBy            String?            @map("updated_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Doubles as the optimistic-concurrency token: the API exposes
  /// `updatedAt.toISOString()` as `version`. Lifecycle transitions additionally
  /// put both this and `status` in the `updateMany` WHERE clause, because a
  /// read-then-write check cannot stop a concurrent approve/reject (Scenario 52).
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch       @relation(fields: [orgId, branchId], references: [orgId, branchId])
  customer     Customer     @relation(fields: [orgId, customerId], references: [orgId, customerId])
  loanProduct  LoanProduct  @relation(fields: [orgId, loanProductId], references: [orgId, loanProductId])
  loanScheme   LoanScheme   @relation(fields: [orgId, loanSchemeId], references: [orgId, loanSchemeId])

  documents         LoanApplicationDocument[]
  reviews           LoanApplicationReview[]
  creditAssessments CreditAssessment[]
  sanctionLetter    SanctionLetter?
  loans             Loan[]

  @@id([orgId, applicationId])
  @@unique([orgId, applicationNumber])
  @@index([orgId, customerId])
  @@index([orgId, branchId, status])
  @@index([orgId, status])
  @@map("loan_applications")
}

/// Supporting documents for an application (ID / Income / Collateral, Rule 34).
/// Deliberately field-for-field the same shape as `CustomerDocument` and
/// `GuarantorDocument`: the storage, supersede and verification rules are
/// identical, and a second document idiom in one codebase is how the three drift.
/// Separate table, so an application reviewer's reach never extends to borrower
/// or guarantor KYC.
model LoanApplicationDocument {
  orgId                 String         @map("org_id") @db.Uuid
  applicationDocumentId String         @default(uuid()) @map("application_document_id") @db.Uuid
  applicationId         String         @map("application_id") @db.Uuid
  documentType          String         @map("document_type") @db.VarChar(50)
  /// Opaque storage key, never a URL and never a client-supplied filename. The
  /// bytes are only reachable through an endpoint that re-checks scope.
  fileRef               String         @map("file_ref")
  /// Original upload name, kept for display and for the download filename only.
  fileName              String?        @map("file_name") @db.VarChar(255)
  /// Decided by magic bytes at upload, not by the client's Content-Type header.
  mimeType              String?        @map("mime_type") @db.VarChar(100)
  fileSize              Int?           @map("file_size")
  documentNumber        String?        @map("document_number") @db.VarChar(100)
  /// Replacement uploads insert a new row at `version + 1` rather than editing
  /// this one, so the copy a reviewer's decision referred to stays auditable
  /// (Rule 91, Q-APP-66/67).
  version               Int            @default(1)
  supersededAt          DateTime?      @map("superseded_at") @db.Timestamptz(6)
  status                DocumentStatus @default(PENDING)
  /// Why a document was rejected. Required when status becomes REJECTED.
  verificationReason    String?        @map("verification_reason")
  verifiedAt            DateTime?      @map("verified_at") @db.Timestamptz(6)
  verifiedBy            String?        @map("verified_by") @db.Uuid
  uploadedBy            String         @map("uploaded_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  application  LoanApplication @relation(fields: [orgId, applicationId], references: [orgId, applicationId], onDelete: Cascade)

  @@id([orgId, applicationDocumentId])
  @@index([orgId, applicationId])
  @@index([orgId, applicationId, documentType])
  @@map("loan_application_documents")
}

/// Append-only review history. Doubles as the terms-change log: a MODIFY_TERMS
/// row carries the terms as they stood *before* the change (Rules 66-70,
/// Scenario 60), so replaying rows in `createdAt` order reconstructs every set of
/// terms the application ever had. The originally submitted terms are the
/// `previous*` values on the oldest MODIFY_TERMS row; the current terms live on
/// `LoanApplication`. Storing the previous rather than the new values is what
/// makes a separate "submission snapshot" row unnecessary.
///
/// The audit log also records these changes, but is deliberately not the primary
/// mechanism: it is a cross-cutting security record, not a queryable domain
/// history, and a user-facing terms panel must not be coupled to its schema.
model LoanApplicationReview {
  orgId                   String                    @map("org_id") @db.Uuid
  reviewId                String                    @default(uuid()) @map("review_id") @db.Uuid
  applicationId           String                    @map("application_id") @db.Uuid
  reviewerId              String                    @map("reviewer_id") @db.Uuid
  reviewType              ApplicationReviewType     @map("review_type")
  decision                ApplicationReviewDecision
  comments                String?
  rejectionReason         String?                   @map("rejection_reason")
  /// Set only on MODIFY_TERMS rows; null everywhere else.
  previousInterestType    InterestType?             @map("previous_interest_type")
  previousInterestRateBps BigInt?                   @map("previous_interest_rate_bps")
  previousFrequency       RepaymentFrequency?       @map("previous_frequency")
  previousDurationCount   Int?                      @map("previous_duration_count")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  application  LoanApplication @relation(fields: [orgId, applicationId], references: [orgId, applicationId], onDelete: Cascade)

  @@id([orgId, reviewId])
  @@index([orgId, applicationId])
  @@map("loan_application_reviews")
}

/// Credit assessment — CIBIL and income check (Module 08 Rule 2, Scenario 7).
///
/// Append-only rather than one mutable row per application: a reviewer
/// re-running an assessment after a term change must not erase what an earlier
/// decision was taken against. `supersededAt` marks the older rows; exactly one
/// row per application has it null, and that is the row `approve` gates on.
/// Supersession is also the *override* mechanism (Q-APP-26/27/28) — a reviewer
/// who disagrees with a MANUAL_REVIEW records a fresh PASS with notes, and the
/// superseded row is the audit trail. No override concept, no second approval,
/// no hierarchy.
///
/// There is deliberately no bureau integration. The source names "CIBIL Check"
/// and "Income Check" but no provider, no API and no failure semantics
/// (Q-APP-24, Q-APP-25), so an assessment is a reviewer's recorded finding.
/// These columns are the seam an automated fetch would populate instead.
model CreditAssessment {
  orgId              String                  @map("org_id") @db.Uuid
  assessmentId       String                  @default(uuid()) @map("assessment_id") @db.Uuid
  applicationId      String                  @map("application_id") @db.Uuid
  cibilScore         Int?                    @map("cibil_score")
  /// Null means "not checked"; false means "checked and failed". The two are
  /// not the same — Scenario 9 turns on a failed check never becoming a pass,
  /// and a nullable boolean read as falsy would collapse them.
  incomeVerified     Boolean?                @map("income_verified")
  incomeMonthlyPaise BigInt?                 @map("income_monthly_paise")
  assessmentResult   CreditAssessmentResult? @map("assessment_result")
  assessmentNotes    String?                 @map("assessment_notes")
  assessedBy         String?                 @map("assessed_by") @db.Uuid
  assessedAt         DateTime?               @map("assessed_at") @db.Timestamptz(6)
  /// Set when a later assessment replaces this one. Never deleted.
  supersededAt       DateTime?               @map("superseded_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  application  LoanApplication @relation(fields: [orgId, applicationId], references: [orgId, applicationId], onDelete: Cascade)

  @@id([orgId, assessmentId])
  @@index([orgId, applicationId])
  /// The approval gate's read path: "the one current assessment".
  ///
  /// Not a partial unique index on `(org_id, application_id) WHERE
  /// superseded_at IS NULL`, which is what would actually enforce "exactly one
  /// current row": Prisma cannot express partial unique indexes, and adding one
  /// through raw SQL would leave the schema file and the database disagreeing.
  /// Supersede-then-insert happens inside one transaction instead.
  @@index([orgId, applicationId, supersededAt])
  @@map("credit_assessments")
}

/// The sanction letter issued after approval (Module 08 Rule 8, Scenario 30).
///
/// One row per application, created at issue and afterwards only ever updated
/// to record the customer's response and the signed agreement.
///
/// The terms are snapshotted from the application rather than accepted from the
/// caller. That is what makes Q-APP-70 ("can sanctioned terms differ from
/// approved terms?") answer itself — they cannot, so Q-APP-71's re-approval
/// question never arises.
///
/// No file is generated. The source asks for a Loan Sanction Letter but defines
/// no fields (Q-APP-65) and no generation semantics (Q-APP-66/67); a renderer
/// would read these columns.
model SanctionLetter {
  orgId                     String             @map("org_id") @db.Uuid
  sanctionLetterId          String             @default(uuid()) @map("sanction_letter_id") @db.Uuid
  applicationId             String             @map("application_id") @db.Uuid
  /// Allocated per organization as SL-000001 upward — the same shape and the
  /// same numeric-max allocation as `applicationNumber`. Never a lexical sort.
  sanctionNumber            String             @map("sanction_number") @db.VarChar(50)
  /// Terms as approved. Money in paise, rate in basis points.
  sanctionedAmountPaise     BigInt             @map("sanctioned_amount_paise")
  interestType              InterestType       @map("interest_type")
  interestRateBps           BigInt             @map("interest_rate_bps")
  repaymentFrequency        RepaymentFrequency @map("repayment_frequency")
  durationCount             Int                @map("duration_count")
  /// The installment the schedule resolved to at issue, stored so the letter
  /// still reads the same a year later even if the calculator changes.
  installmentAmountPaise    BigInt             @map("installment_amount_paise")
  totalPayablePaise         BigInt             @map("total_payable_paise")
  issuedAt                  DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy                  String             @map("issued_by") @db.Uuid
  /// Recorded, not enforced. The source neither defines an expiry nor says what
  /// happens at one (Q-APP-68).
  validUntil                DateTime?          @map("valid_until") @db.Date
  notes                     String?
  customerResponse          SanctionResponse   @default(PENDING) @map("customer_response")
  customerRespondedAt       DateTime?          @map("customer_responded_at") @db.Timestamptz(6)
  /// Who *recorded* the response — not the customer. There is no customer-facing
  /// surface in this system, so acceptance and decline are staff-recorded facts
  /// (Q-APP-72/73/74).
  responseRecordedBy        String?            @map("response_recorded_by") @db.Uuid
  /// Free text when the customer declines. Mirrored onto the application's
  /// `rejectionReason`, because the unified REJECTED status carries no
  /// information on its own (Rule 13, Rule 40).
  declineReason             String?            @map("decline_reason")
  /// Agreement signing (Rules 11, 12; Scenario 33). A recorded fact: nothing is
  /// generated and nothing is electronically signed (Q-APP-75/76/77).
  agreementSignedAt         DateTime?          @map("agreement_signed_at") @db.Timestamptz(6)
  agreementSignedRecordedBy String?            @map("agreement_signed_recorded_by") @db.Uuid
  agreementReference        String?            @map("agreement_reference") @db.VarChar(100)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  application  LoanApplication @relation(fields: [orgId, applicationId], references: [orgId, applicationId], onDelete: Cascade)

  @@id([orgId, sanctionLetterId])
  /// One letter per application. Reissue is not defined by the source
  /// (Q-APP-69), and this constraint is what makes a second issue a database
  /// error rather than a silent duplicate — the second belt behind the
  /// APPROVED-only status guard.
  @@unique([orgId, applicationId])
  @@unique([orgId, sanctionNumber])
  @@map("sanction_letters")
}

enum SanctionResponse {
  PENDING
  ACCEPTED
  DECLINED

  @@map("sanction_response")
}

// ============================================================================
// 10. LOANS
//
// No mutable balance columns. All balances derive from journal lines.
// ============================================================================

model Loan {
  orgId                String             @map("org_id") @db.Uuid
  loanId               String             @default(uuid()) @map("loan_id") @db.Uuid
  loanNumber           String             @map("loan_number") @db.VarChar(50)
  branchId             String             @map("branch_id") @db.Uuid
  customerId           String             @map("customer_id") @db.Uuid
  applicationId        String             @map("application_id") @db.Uuid
  loanProductId        String             @map("loan_product_id") @db.Uuid
  loanSchemeId         String             @map("loan_scheme_id") @db.Uuid
  principalAmountPaise BigInt             @map("principal_amount_paise")
  interestRateBps      BigInt             @map("interest_rate_bps")
  interestType         InterestType       @map("interest_type")
  repaymentFrequency   RepaymentFrequency @map("repayment_frequency")
  durationCount        Int                @map("duration_count")
  status               LoanStatus
  sanctionDate         DateTime?          @map("sanction_date") @db.Date
  agreementDate        DateTime?          @map("agreement_date") @db.Date
  disbursementDate     DateTime?          @map("disbursement_date") @db.Date
  closureDate          DateTime?          @map("closure_date") @db.Date
  createdBy            String?            @map("created_by") @db.Uuid
  updatedBy            String?            @map("updated_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  branch       Branch          @relation(fields: [orgId, branchId], references: [orgId, branchId])
  customer     Customer        @relation(fields: [orgId, customerId], references: [orgId, customerId])
  application  LoanApplication @relation(fields: [orgId, applicationId], references: [orgId, applicationId])
  loanProduct  LoanProduct     @relation(fields: [orgId, loanProductId], references: [orgId, loanProductId])
  loanScheme   LoanScheme      @relation(fields: [orgId, loanSchemeId], references: [orgId, loanSchemeId])

  loanGuarantors       LoanGuarantor[]
  repaymentSchedules   RepaymentSchedule[]
  emis                 Emi[]
  disbursements        Disbursement[]
  collections          Collection[]
  penalties            Penalty[]
  penaltyRuleOverrides LoanPenaltyRuleOverride[]
  fieldVisits          FieldVisit[]
  recoveryCases        RecoveryCase[]
  settlements          Settlement[]
  loanClosures         LoanClosure[]
  nocs                 Noc[]
  receipts             Receipt[]

  @@id([orgId, loanId])
  @@unique([orgId, loanNumber])
  @@index([orgId, customerId])
  @@index([orgId, branchId, status])
  @@index([orgId, status])
  @@map("loans")
}

model LoanGuarantor {
  orgId           String   @map("org_id") @db.Uuid
  loanGuarantorId String   @default(uuid()) @map("loan_guarantor_id") @db.Uuid
  loanId          String   @map("loan_id") @db.Uuid
  guarantorId     String   @map("guarantor_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan         Loan         @relation(fields: [orgId, loanId], references: [orgId, loanId], onDelete: Cascade)
  guarantor    Guarantor    @relation(fields: [orgId, guarantorId], references: [orgId, guarantorId])

  @@id([orgId, loanGuarantorId])
  @@unique([orgId, loanId, guarantorId])
  @@map("loan_guarantors")
}

// ============================================================================
// 11. REPAYMENT SCHEDULE / EMI
// ============================================================================

/// The authoritative repayment schedule for a loan.
///
/// `version` is the *schedule* version, not a concurrency token: version 1 is
/// generated inside the disbursal transaction, and a permitted regeneration
/// (Module 10 Scenario 16) marks the current row `SUPERSEDED` and inserts
/// version N+1. `@@unique([orgId, loanId, version])` is what makes a duplicate
/// generation a database error rather than a second live schedule, and only one
/// row per loan may be `ACTIVE` at a time.
///
/// `updatedAt` is the optimistic-concurrency token, exposed to clients as
/// `version` — the same convention `Disbursement` and `LoanApplication` use, and
/// what lets a stale client be refused rather than silently overwrite a newer
/// schedule (Scenarios 36, 41).
///
/// `disbursementId` records which disbursal produced version 1. Nullable because
/// a regenerated version descends from the loan's terms rather than from a
/// second disbursal, and because Module 09 rows predate the column.
model RepaymentSchedule {
  orgId               String                  @map("org_id") @db.Uuid
  repaymentScheduleId String                  @default(uuid()) @map("repayment_schedule_id") @db.Uuid
  loanId              String                  @map("loan_id") @db.Uuid
  disbursementId      String?                 @map("disbursement_id") @db.Uuid
  version             Int
  generatedAt         DateTime                @map("generated_at") @db.Timestamptz(6)
  generatedBy         String?                 @map("generated_by") @db.Uuid
  status              RepaymentScheduleStatus
  /// Set together when this version is retired. Never cleared — a superseded
  /// schedule is financial history and is never physically deleted (Rule 22).
  supersededAt        DateTime?               @map("superseded_at") @db.Timestamptz(6)
  supersededBy        String?                 @map("superseded_by") @db.Uuid
  /// Why this version was generated. Recorded on the *new* row, so the reason
  /// travels with the schedule it produced (Scenario 43).
  regenerationReason  String?                 @map("regeneration_reason")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan         Loan          @relation(fields: [orgId, loanId], references: [orgId, loanId], onDelete: Cascade)
  disbursement Disbursement? @relation(fields: [orgId, disbursementId], references: [orgId, disbursementId])

  emis Emi[]

  @@id([orgId, repaymentScheduleId])
  @@unique([orgId, loanId, version])
  /// The ACTIVE-schedule lookup runs on every schedule read; without this it is
  /// a scan of every version the loan has ever had.
  @@index([orgId, loanId, status])
  @@map("repayment_schedules")
}

/// One installment of a repayment schedule.
///
/// The `*DuePaise` columns are contractual and never change: a part-payment
/// updates `paidAmountPaise` and `outstandingAmountPaise` and leaves the amount
/// owed under the contract exactly as generated (Rule 33, Scenario 25).
///
/// `status` is the *persisted* status and stays `PENDING` until a payment or a
/// lifecycle action touches the row. `PENDING → DUE → OVERDUE` is **not** swept
/// by any job: it is derived at read time by comparing `dueDate` to the
/// Asia/Kolkata business date, so no row is ever stale and the client's clock
/// never decides an EMI's state (Scenarios 23, 24, 39). See `deriveEmiStatus`.
model Emi {
  orgId                  String    @map("org_id") @db.Uuid
  emiId                  String    @default(uuid()) @map("emi_id") @db.Uuid
  repaymentScheduleId    String    @map("repayment_schedule_id") @db.Uuid
  loanId                 String    @map("loan_id") @db.Uuid
  installmentNumber      Int       @map("installment_number")
  dueDate                DateTime  @map("due_date") @db.Date
  /// Principal outstanding *before* this installment. The financed principal on
  /// installment 1, and the previous row's closing balance thereafter.
  openingPrincipalPaise  BigInt    @map("opening_principal_paise")
  principalDuePaise      BigInt    @map("principal_due_paise")
  interestDuePaise       BigInt    @map("interest_due_paise")
  totalDuePaise          BigInt    @map("total_due_paise")
  /// Maintained by collection allocation (Module 11). Generation never writes a
  /// payment: a generated EMI is not a receipt (Rules 12, 13, 14).
  paidAmountPaise        BigInt    @default(0) @map("paid_amount_paise")
  outstandingAmountPaise BigInt    @map("outstanding_amount_paise")
  status                 EmiStatus
  paidAt                 DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization      @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  repaymentSchedule RepaymentSchedule @relation(fields: [orgId, repaymentScheduleId], references: [orgId, repaymentScheduleId], onDelete: Cascade)
  loan              Loan              @relation(fields: [orgId, loanId], references: [orgId, loanId], onDelete: Cascade)

  allocations   CollectionAllocation[]
  penalties     Penalty[]
  recoveryCases RecoveryCase[]

  @@id([orgId, emiId])
  @@unique([orgId, repaymentScheduleId, installmentNumber])
  @@index([orgId, dueDate])
  @@index([orgId, loanId, status])
  @@index([orgId, status, dueDate])
  @@map("emis")
}

// ============================================================================
// 12. DISBURSEMENT
// ============================================================================

/// Module 09. The financial record of a loan's disbursal.
///
/// `idempotencyKey` is client-minted and required, mirroring `Collection`'s
/// column of the same name: a retried confirmation must return the original
/// result rather than move money twice (Module 09 Scenarios 28, 46). The unique
/// index is the real guarantee — the service's replay check only makes the
/// replay *readable*.
///
/// `transactionReference` is unique at organization scope (Rule 18, Scenario
/// 17), which answers the source's Open Question 30. It stays nullable because
/// a cash disbursal has no reference; Postgres does not collide NULLs in a
/// unique index, so many cash rows coexist.
///
/// `updatedAt` is the optimistic-concurrency token, exposed to clients as
/// `version` exactly as `LoanApplication.updatedAt` is.
model Disbursement {
  orgId                 String             @map("org_id") @db.Uuid
  disbursementId        String             @default(uuid()) @map("disbursement_id") @db.Uuid
  loanId                String             @map("loan_id") @db.Uuid
  branchId              String             @map("branch_id") @db.Uuid
  scheduledDate         DateTime           @map("scheduled_date") @db.Date
  disbursementAccountId String             @map("disbursement_account_id") @db.Uuid
  disbursedAt           DateTime?          @map("disbursed_at") @db.Timestamptz(6)
  amountPaise           BigInt             @map("amount_paise")
  paymentMode           PaymentMode        @map("payment_mode")
  bankAccountReference  String?            @map("bank_account_reference")
  transactionReference  String?            @map("transaction_reference") @db.VarChar(150)
  transferDate          DateTime?          @map("transfer_date") @db.Date
  status                DisbursementStatus
  idempotencyKey        String             @map("idempotency_key") @db.VarChar(150)
  journalEntryId        String?            @map("journal_entry_id") @db.Uuid
  failureReason         String?            @map("failure_reason")
  createdBy             String             @map("created_by") @db.Uuid
  confirmedBy           String?            @map("confirmed_by") @db.Uuid
  confirmedAt           DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan                Loan          @relation(fields: [orgId, loanId], references: [orgId, loanId])
  branch              Branch        @relation(fields: [orgId, branchId], references: [orgId, branchId])
  disbursementAccount Account       @relation("DisbursementFundingAccount", fields: [orgId, disbursementAccountId], references: [orgId, accountId])
  journalEntry        JournalEntry? @relation(fields: [orgId, journalEntryId], references: [orgId, journalEntryId])

  repaymentSchedules RepaymentSchedule[]

  @@id([orgId, disbursementId])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, transactionReference])
  @@index([orgId, loanId])
  @@index([orgId, branchId, status])
  @@map("disbursements")
}

// ============================================================================
// 13. EMI COLLECTION
// ============================================================================

/// Module 11. A repayment received against a loan.
///
/// # What is authoritative
///
/// Only `POSTED` and `REVERSED` rows are money. A `CREATED`/`SYNCED` row is a
/// request that has not moved anything (Rule 39). That is why the sum identity
/// below is a *conditional* CHECK: an unposted row legitimately has a positive
/// `amountPaise` and no allocation, because the allocation does not exist until
/// the posting transaction computes it.
///
/// # Immutability
///
/// A posted collection cannot be edited or deleted (Rules 21, 22, 44). The
/// `collections_append_only` trigger enforces that in the database, permitting
/// exactly one transition — `POSTED → REVERSED` with every financial column
/// unchanged. Corrections are reversals, never edits (Scenarios 25, 27, 28).
///
/// # Idempotency
///
/// `idempotencyKey` is client-minted and required; `requestFingerprint` is a
/// SHA-256 of the canonical request body. The same key with the same
/// fingerprint replays the original result as a success; the same key with a
/// different fingerprint is a 409 (Rules 8, 9; Scenarios 13, 14). The unique
/// index is the real guarantee — the service's replay check only makes the
/// replay readable.
///
/// # Deliberately absent: `receiptId`
///
/// `Receipt.collectionId` already points this way. Adding the reverse column
/// would make a circular foreign key for one saved join. `receiptNumber` is
/// denormalised here instead, carrying its own unique index so a duplicate
/// receipt is a database error (Scenario 16); `Receipt` stays authoritative.
///
/// `updatedAt` is the optimistic-concurrency token, exposed to clients as
/// `version` exactly as `Disbursement.updatedAt` is (Scenario 26).
model Collection {
  orgId                  String                    @map("org_id") @db.Uuid
  collectionId           String                    @default(uuid()) @map("collection_id") @db.Uuid
  loanId                 String                    @map("loan_id") @db.Uuid
  branchId               String                    @map("branch_id") @db.Uuid
  customerId             String                    @map("customer_id") @db.Uuid
  collectorUserId        String                    @map("collector_user_id") @db.Uuid
  collectionDate         DateTime                  @map("collection_date") @db.Date
  collectedAt            DateTime                  @map("collected_at") @db.Timestamptz(6)
  paymentType            PaymentType               @map("payment_type")
  paymentMode            PaymentMode               @map("payment_mode")
  amountPaise            BigInt                    @map("amount_paise")
  transactionReference   String?                   @map("transaction_reference") @db.VarChar(150)
  idempotencyKey         String                    @map("idempotency_key") @db.VarChar(150)
  /// SHA-256 hex of the canonical request body. Deliberately excludes `notes`
  /// and `deviceId`: a corrected typo in a note is not "a materially different
  /// payment request" (Rule 9).
  requestFingerprint     String?                   @map("request_fingerprint") @db.VarChar(64)
  status                 CollectionStatus          @map("collection_status")
  verificationStatus     PaymentVerificationStatus @map("verification_status")
  partialPaymentReason   String?                   @map("partial_payment_reason")
  verificationNotes      String?                   @map("verification_notes")
  /// Denormalised from `Receipt`. Minted only inside the posting transaction,
  /// so a number is never issued for a posting that did not commit.
  receiptNumber          String?                   @map("receipt_number") @db.VarChar(100)
  /// The allocation result (Rule 13). Their sum equals `amountPaise` on any
  /// posted row — asserted by the `collections_allocation_sums` CHECK.
  penaltyPaidPaise       BigInt                    @default(0) @map("penalty_paid_paise")
  interestPaidPaise      BigInt                    @default(0) @map("interest_paid_paise")
  principalPaidPaise     BigInt                    @default(0) @map("principal_paid_paise")
  /// The fee path is built and tested but has no source yet: no fee module
  /// exists, so this is always 0 today.
  feesPaidPaise          BigInt                    @default(0) @map("fees_paid_paise")
  /// Always 0. Overpayment is rejected rather than held as unapplied credit,
  /// so nothing is ever left over. The column exists because the source's money
  /// identity names it and a future advance-payment feature needs it without a
  /// migration.
  unallocatedAmountPaise BigInt                    @default(0) @map("unallocated_amount_paise")
  journalEntryId         String?                   @map("journal_entry_id") @db.Uuid
  postedAt               DateTime?                 @map("posted_at") @db.Timestamptz(6)
  postedBy               String?                   @map("posted_by") @db.Uuid
  /// Set on the *reversal* row, pointing at the collection it reverses. Unique
  /// at organization scope, which is what makes a second reversal of the same
  /// collection a database error rather than a check (Scenario 33).
  reversalOfCollectionId String?                   @map("reversal_of_collection_id") @db.Uuid
  reversalReason         String?                   @map("reversal_reason")
  reversedAt             DateTime?                 @map("reversed_at") @db.Timestamptz(6)
  reversedBy             String?                   @map("reversed_by") @db.Uuid
  /// Module 11 stores the offline identity and replays on it; the device-side
  /// queue that produces it is Module 12's.
  offlineTransactionUuid String?                   @map("offline_transaction_uuid") @db.Uuid
  deviceId               String?                   @map("device_id") @db.VarChar(150)
  offlineCollected       Boolean                   @default(false) @map("offline_collected")
  syncedAt               DateTime?                 @map("synced_at") @db.Timestamptz(6)
  failureReason          String?                   @map("failure_reason")

  // --- Module 12 (Field collection and cash custody) ---
  //
  // Custody and evidence metadata only. Module 12 deliberately reuses this row
  // rather than creating a parallel `field_collections` table: a field
  // collection *is* a collection, and a second table would mean two receipt
  // sequences, two idempotency namespaces and a second writer of
  // `collection_allocations` — precisely the duplication Rule 8 forbids.

  /// Whether an agent took this money in the field.
  ///
  /// Decides the cash account the posting debits: a field cash collection
  /// debits Field Agent Cash in Hand (1220) rather than branch cash (1210),
  /// because the money is in a person's pocket, not a drawer (Rule 18).
  isFieldCollection Boolean @default(false) @map("is_field_collection")

  /// What the device reported about its GPS capture attempt.
  ///
  /// Stored separately from `gpsCheckInId` because a **failed** capture has no
  /// check-in row to point at, and Rule 41 requires the failure still be
  /// representable. Written from what the client reported and never promoted:
  /// synchronization must not turn a failure into a success (Scenario 55).
  gpsCaptureStatus GpsVerificationStatus? @map("gps_capture_status")

  /// The verified check-in this collection's location evidence came from.
  ///
  /// A reference rather than raw coordinates on purpose. Coordinates copied
  /// into this row would be a position nothing vouches for; pointing at a row
  /// the GPS endpoint already verified is what makes the evidence trustworthy.
  gpsCheckInId String? @map("gps_check_in_id") @db.Uuid

  fieldVisitId String? @map("field_visit_id") @db.Uuid

  /// Whatever the customer signed, stamped or acknowledged. Free text because
  /// the form differs by branch — a signature book page, an SMS id, a photo
  /// filename — and modelling one would exclude the others.
  customerAckReference String? @map("customer_ack_reference") @db.VarChar(150)

  /// The handover that claimed this collection's cash.
  ///
  /// The load-bearing column of the whole module. NULL means the cash is still
  /// with the agent and counts toward their expected balance; non-NULL means it
  /// has been handed over and no longer does. Cash leaves the custody pool by
  /// rows being *claimed* under a guarded update, not by an amount being
  /// subtracted — which is what makes concurrent handovers structurally unable
  /// to double-count the same cash (Scenario 49), and makes Rule 23's
  /// traceability a foreign key rather than a report.
  custodyHandoverId String? @map("custody_handover_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  loan          Loan          @relation(fields: [orgId, loanId], references: [orgId, loanId])
  branch        Branch        @relation(fields: [orgId, branchId], references: [orgId, branchId])
  customer      Customer      @relation(fields: [orgId, customerId], references: [orgId, customerId])
  collectorUser User          @relation(fields: [orgId, collectorUserId], references: [orgId, userId])
  journalEntry  JournalEntry? @relation(fields: [orgId, journalEntryId], references: [orgId, journalEntryId])

  /// The original this row reverses (set only on a reversal row), and the
  /// inverse: the reversal that undid this row, if any.
  reversalOf           Collection? @relation("CollectionReversal", fields: [orgId, reversalOfCollectionId], references: [orgId, collectionId])
  reversedByCollection Collection? @relation("CollectionReversal")

  /// Module 12 evidence and custody links.
  gpsCheckIn      GpsCheckIn?   @relation(fields: [orgId, gpsCheckInId], references: [orgId, checkInId])
  fieldVisit      FieldVisit?   @relation(fields: [orgId, fieldVisitId], references: [orgId, visitId])
  custodyHandover CashHandover? @relation(fields: [orgId, custodyHandoverId], references: [orgId, handoverId])

  allocations   CollectionAllocation[]
  verifications CollectionVerification[]
  receipts      Receipt[]
  loanClosures  LoanClosure[]

  @@id([orgId, collectionId])
  @@unique([orgId, idempotencyKey])
  @@unique([orgId, receiptNumber])
  @@unique([orgId, offlineTransactionUuid])
  @@unique([orgId, reversalOfCollectionId])
  @@index([orgId, branchId, collectionDate])
  @@index([orgId, collectorUserId, collectionDate])
  @@index([orgId, loanId])
  @@index([orgId, status, collectionDate])
  /// The agent cash-custody derivation (Rule 24). Every read of an agent's
  /// expected balance and every handover transaction runs this predicate, so it
  /// is the hottest query in the module.
  @@index([orgId, collectorUserId, isFieldCollection, paymentMode, status, custodyHandoverId])
  @@index([orgId, custodyHandoverId])
  @@map("collections")
}

model CollectionAllocation {
  orgId        String              @map("org_id") @db.Uuid
  allocationId String              @default(uuid()) @map("allocation_id") @db.Uuid
  collectionId String              @map("collection_id") @db.Uuid
  emiId        String?             @map("emi_id") @db.Uuid
  component    CollectionComponent
  amountPaise  BigInt              @map("amount_paise")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  collection   Collection   @relation(fields: [orgId, collectionId], references: [orgId, collectionId], onDelete: Cascade)
  emi          Emi?         @relation(fields: [orgId, emiId], references: [orgId, emiId])

  @@id([orgId, allocationId])
  @@index([orgId, collectionId])
  @@index([orgId, emiId])
  @@map("collection_allocations")
}

model CollectionVerification {
  orgId             String                    @map("org_id") @db.Uuid
  verificationId    String                    @default(uuid()) @map("verification_id") @db.Uuid
  collectionId      String                    @map("collection_id") @db.Uuid
  status            PaymentVerificationStatus
  verifiedBy        String?                   @map("verified_by") @db.Uuid
  verificationNotes String?                   @map("verification_notes")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  collection   Collection   @relation(fields: [orgId, collectionId], references: [orgId, collectionId], onDelete: Cascade)

  @@id([orgId, verificationId])
  @@index([orgId, collectionId])
  @@map("collection_verifications")
}

