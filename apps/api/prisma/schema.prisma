// --- Field cash custody (Module 12) ---

/// The handover lifecycle.
///
/// `CANCELLED` and `REVERSED` are not in the source's four-state diagram. They
/// are added because that diagram has no terminal failure state: without them
/// an agent who drafted a handover in error would have to submit it, and a
/// branch that received cash in error would have no way to say so
/// (Scenario 53).
///
/// There is no `QUEUED_FOR_SYNC` analogue here, and no offline handover: cash
/// physically changes hands at a branch counter, so the act is online by
/// definition.
enum CashHandoverStatus {
  CREATED
  SUBMITTED
  RECEIVED
  RECONCILED
  CANCELLED
  REVERSED

  @@map("cash_handover_status")
}

/// The reconciliation lifecycle, flattened.
///
/// The source draws `RECONCILED` as a parent with `MATCHED` and
/// `DISCREPANCY_PENDING` beneath it. Persisted as a parent plus a child, every
/// query would filter on two columns and a row could hold an incoherent pair —
/// `PENDING` alongside `MATCHED`. One four-value enum cannot express the
/// incoherent state at all, so `RECONCILED` is not a persisted value.
///
/// `PENDING` exists for Scenario 54: a reconciliation whose expected balance
/// could not be derived is not finalised and must stay visible for controlled
/// retry, rather than silently becoming a match.
enum CashReconciliationStatus {
  PENDING
  MATCHED
  DISCREPANCY_PENDING
  RESOLVED

  @@map("cash_reconciliation_status")
}

/// Why the count came out wrong.
///
/// `SHORTAGE` and `EXCESS` are the arithmetic cases; the other four describe
/// the cause, which is what makes a shortage from a counterfeit note
/// distinguishable from one caused by theft. Rule 34 forbids silent
/// auto-correction, and a bare signed difference with no cause is how a system
/// ends up silently correcting.
enum CashDiscrepancyType {
  SHORTAGE
  EXCESS
  COUNTERFEIT
  DAMAGED_NOTES
  DISPUTED_COLLECTION
  OTHER

  @@map("cash_discrepancy_type")
}

/// What was decided about the difference.
///
/// None of these post a journal. Rule 36 and Scenario 29 both say an accounting
/// adjustment "follows a separately authorized financial rule" — Module 14's
/// manual journal is that rule, and `CashReconciliation.approvalReference` is
/// where its entry number is recorded. These values say what was decided, not
/// what was posted.
enum CashDiscrepancyResolution {
  RECOVERED_FROM_AGENT
  WRITTEN_OFF
  ADJUSTED_NEXT_HANDOVER
  ESCALATED
  NO_ACTION

  @@map("cash_discrepancy_resolution")
}

// --- Field Employee GPS Check-in ---

/// Outcome of one GPS check-in attempt.
///
/// `PENDING` exists for the mid-flow network-loss case (GPS Scenario 17): the
/// attempt reached the server but could not be confirmed, and must never be
/// silently promoted to `VERIFIED`. `EXPIRED` and `CANCELLED` are reserved by
/// the story's field list; nothing writes them yet.
enum GpsVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  CANCELLED

  @@map("gps_verification_status")
}

/// Device location-permission state as reported by the client.
///
/// `UNKNOWN` is the safe default rather than `GRANTED`: an unstated permission
/// must fail closed (GPS Rule 8).
enum GpsPermissionStatus {
  GRANTED
  DENIED
  UNAVAILABLE
  UNKNOWN

  @@map("gps_permission_status")
}

/// Network state at the moment of the attempt. Offline Mode is deliberately a
/// distinct value, never an absent one, so an offline attempt can never be read
/// back as a server-verified check-in (GPS Rule 18).
enum GpsNetworkStatus {
  ONLINE
  OFFLINE

  @@map("gps_network_status")
}

/// Why a check-in failed. Split by cause rather than carried as free text so
/// each failure mode is independently queryable and alertable — the same
/// reasoning as the split `AuditAction` failure entries.
enum GpsFailureReason {
  PERMISSION_DENIED
  POSITION_UNAVAILABLE
  TIMEOUT
  ACCURACY_REJECTED
  STALE_LOCATION
  INVALID_COORDINATES
  PROVIDER_ERROR
  NETWORK_LOST
  PERSISTENCE_FAILED
  CANCELLED

  @@map("gps_failure_reason")
}

