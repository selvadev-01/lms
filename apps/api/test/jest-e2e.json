{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(?!.*node_modules)(.{1,2}/.*)\\.js$": "$1",
    "^@lms/validation$": "<rootDir>/../../../packages/validation/src/index.ts"
  }
}
