# Copy to .env and fill in real values. Never commit .env.
#
# PostgreSQL connection used by Prisma for both the client and migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_dev?schema=public"

# --- Authentication ---------------------------------------------------------
# Required. No default is permitted; the API refuses to boot without it.
AUTH_JWT_SECRET="change-me-to-a-random-32-character-minimum-secret"
# Origin allowed to send credentialed requests.
WEB_ORIGIN="http://localhost:3000"
# Reverse proxies in front of this process. MUST be set behind a load balancer:
# left at 0, Express reports the balancer's address as req.ip, so every caller
# shares one per-IP rate-limit bucket and audit records cannot attribute a
# failed sign-in to whoever made it. Deliberately a hop count, not "true" —
# trusting the whole chain would let a client forge its own apparent address.
# TRUSTED_PROXY_HOPS=0

# Optional tunables — see src/config/auth.config.ts for defaults.
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCK_DURATION_MINUTES=15
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL_DAYS=7
# How long a dead session row is kept before pruneDeadSessions removes it.
# Rotation writes one row per refresh, so without pruning user_sessions grows
# without bound — and it is read on every authenticated request. 0 keeps every
# row for ever.
# AUTH_SESSION_RETENTION_DAYS=90
# AUTH_MAX_CONCURRENT_SESSIONS=0
# Idle timeout: no accepted activity for this long expires the session.
# AUTH_IDLE_TIMEOUT_MINUTES=30
# Minimum gap between last_seen_at writes, so idle tracking is not a write per request.
# AUTH_SESSION_ACTIVITY_WRITE_SECONDS=60
# AUTH_COOKIE_SECURE=false

# --- Password policy (Q-PWD-1..4, Q-PWD-8) ----------------------------------
# Applied only when a password is SET (reset/change), never at sign-in, where
# enforcing the policy would leak it and lock out older passwords.
# AUTH_PASSWORD_MIN_LENGTH=12
# AUTH_PASSWORD_MAX_LENGTH=200
# How many of upper/lower/digit/symbol a password must use (max 4).
# AUTH_PASSWORD_REQUIRED_CLASSES=3
# Previous passwords that may not be reused. Each costs one argon2
# verification per reset; 0 disables history entirely.
# AUTH_PASSWORD_HISTORY_DEPTH=5

# --- Password recovery ------------------------------------------------------
# Deployment-wide SMS gateway: "console" or "twilio". Used only for
# organizations with no row in sms_provider_configs — a per-organization row
# takes precedence, so one deployment can serve orgs on different gateways.
#
# "console" logs the OTP instead of sending it and refuses to start when
# NODE_ENV=production.
# SMS_PROVIDER=console

# Twilio credentials. Deliberately environment-only and never stored in the
# database: sms_provider_configs records which gateway an org uses and how to
# address it, but must never hold something that can send SMS at your cost.
# Required when SMS_PROVIDER=twilio, or when any org row selects TWILIO.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
#
# Sender: a Messaging Service is preferred over a bare number — Twilio then
# handles sender-ID selection and failover, which matters for Indian
# deliverability. Either may also be set per organization in the database.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
#
# E.164 prefix applied to the 10-digit numbers stored on users.
# TWILIO_DEFAULT_COUNTRY_CODE=+91
#
# NOTE: on a Twilio trial account every recipient must first be added under
# Console -> Phone Numbers -> Verified Caller IDs, or sends fail with 21608.

# AUTH_RECOVERY_OTP_LENGTH=6
# AUTH_RECOVERY_OTP_TTL_MINUTES=10
# AUTH_RECOVERY_MAX_OTP_ATTEMPTS=5
# AUTH_RECOVERY_RESEND_COOLDOWN_SECONDS=60
# AUTH_RECOVERY_MAX_RESENDS=3
# AUTH_RECOVERY_TOKEN_TTL_MINUTES=15
# Per-IP requests per minute. Raise only for local test runs, where many
# parallel workers share one address.
# AUTH_RECOVERY_RATE_LIMIT=5
# AUTH_RECOVERY_VERIFY_RATE_LIMIT=10
# Per-IP sign-in ceiling per minute. Blunts distributed guessing that the
# per-account lockout cannot see. Raise it for e2e runs, which authenticate far
# more often than any real user from a single address.
# AUTH_SIGN_IN_RATE_LIMIT=20
# Per-IP ceiling per minute for every endpoint without a stricter named limit.
# Sized for the dashboard, which spends nine requests on one page view (the
# layout plus one per widget) so that a single widget can fail and retry alone.
# At the previous 60 a second page view in the same minute made the trailing
# widgets 429, which the UI renders as "This widget could not be loaded".
# DEFAULT_RATE_LIMIT=240

# --- Field operations: GPS check-in ----------------------------------------
# Applied defaults for Q-GPS-1, Q-GPS-7, Q-GPS-10 and Q-GPS-12, which the
# source flow diagram leaves undefined. Unset is fine — each has a documented
# default in src/config/field.config.ts. A set-but-unparseable value is a boot
# error rather than a silent fallback.
#
# Worst device-reported accuracy accepted, in metres. 0 disables the rule.
# FIELD_GPS_MAX_ACCURACY_METERS=100
#
# How old a device-reported position may be, in seconds. Must be > 0.
# FIELD_GPS_MAX_LOCATION_AGE_SECONDS=120
#
# How far a device clock may run ahead before its timestamp is disbelieved.
# FIELD_GPS_MAX_CLOCK_SKEW_SECONDS=60
#
# Acquisition timeout handed to the browser, in seconds. Must be > 0.
# FIELD_GPS_TIMEOUT_SECONDS=30
#
# How long a verified check-in authorizes field operations. A check-in also
# dies with its session, so this is the ceiling, not the only limit. Must be > 0.
# FIELD_CHECKIN_VALIDITY_HOURS=12

# --- Public organization signup ------------------------------------------
#
# Lets anyone who can reach POST /auth/sign-up create a new organization: it
# provisions permissions, the three core roles, the chart of accounts, master
# data and notification templates, then mints that organization's first Super
# Admin. Intended for local development and controlled trials.
#
# Default-deny. The endpoint always exists but returns 404 while this is off.
#
# WARNING: switching this on in a deployment reachable from the internet means
# anyone may create a tenant in it. There is no email or mobile verification,
# and each signup writes several hundred rows and burns an argon2 hash, so
# SIGNUP_RATE_LIMIT below is the only thing between the endpoint and a botnet.
# Leave this off in production.
#
# Must be exactly "true" or "false" — a typo fails at boot rather than
# silently leaving signup closed.
# ALLOW_PUBLIC_SIGNUP=false
#
# Signups per minute per IP. Creating an organization is a once-per-lifetime
# act, so single digits is the right order of magnitude. Must be > 0.
# SIGNUP_RATE_LIMIT=3
#
# Provisioning transaction budget. The work is ~12 statements, so this is
# headroom for a cold connection pool rather than a figure the writes need.
# Must be > 0.
# SIGNUP_TRANSACTION_TIMEOUT_MS=30000
