{
  "name": "@lms/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas used by both web and api.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-cjs.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "files": [
    "dist",
    "src"
  ]
}
